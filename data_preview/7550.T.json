40 \uacc4\uc0b0\ud558\uc9c0 \uc54a\uc558\ub2e4.","priced_in.pct_est\ub294 \ud638\uc7ac \ubc18\uc601\ub960\uc774 \uc544\ub2c8\ub77c \ucd5c\uadfc 3\uac1c\uc6d4 \uc8fc\uac00 \uc218\uc775\ub960 \ud504\ub85d\uc2dc\ub2e4.","PER 34\ubc30\u00b728\ubc30\ub294 \uc2dc\ub098\ub9ac\uc624 \uac00\uc815\uc774\uba70 \ubaa9\ud45c\uc8fc\uac00 \ud655\uc815\uce58\uac00 \uc544\ub2c8\ub2e4.","IRBANK\uc758 \ud45c\uc2dc \uc608\uc0c1 PER\uc740 \uc57d 345.1\uc5d4\uc758 \uc81c\uacf5\uc0ac EPS\ub97c \ub0b4\ud3ec\ud574 \ud68c\uc0ac \uacf5\uc2dc EPS 321.99\uc5d4 \uae30\uc900 PER\uacfc \ub2e4\ub974\ub2e4. 34\ubc30\u00b728\ubc30\ub294 \ucd5c\uadfc \uc2e4\uce21 \ubc34\ub4dc\uc5d0 \uc575\ucee4\ub97c \ub454 \ubbfc\uac10\ub3c4\uc77c \ubfd0 \ub3d9\uc77c \uae30\uc900\uc758 \uc5ed\uc0ac \ubc31\ud14c\uc2a4\ud2b8\ub098 \ud53c\uc5b4 \ucee8\uc13c\uc11c\uc2a4\uac00 \uc544\ub2c8\ub2e4.","\ubcf8 \ubb38\uc11c\ub294 \ud22c\uc790\ud310\ub2e8 \ucc38\uace0\uc6a9\uc774\uba70 \ud22c\uc790 \uad8c\uc720\uac00 \uc544\ub2d9\ub2c8\ub2e4."],"review_meta":{"reviewed_on":"2026-08-28","model":"gpt-5.6-sol/ultra","verdict":"upgraded","changes":["\uc6d0\ubcf8 \uc6d4\ucc28\uc758 \ubd84\uae30 \ud6c4 \ucd5c\uc2e0\uce58\uc778 2026\ub144 7\uc6d4 110.9%\ub97c \ucd94\uac00\ud574 \ub450 \uc790\ub9bf\uc218 \uc131\uc7a5 \uc720\uc9c0\uc640 4\uc6d4 \uc774\ud6c4\uc758 \uc5f0\uc18d \ub454\ud654\ub97c \ud568\uaed8 \ub4dc\ub7ec\ub0c8\ub2e4.","minkabu \ucee8\uc13c\uc11c\uc2a4\uc758 \uc9d1\uacc4\uc77c\uc744 2026-08-20\uc73c\ub85c \uba85\uc2dc\ud574 \ubb38\uc11c \uae30\uc900\uc77c \uc218\uce58 56,416\ubc31\ub9cc\uc5d4\u00b712,080\uc5d4\uc758 \uc2dc\uc810 \uc0ac\uc2ac\uc744 \uace0\uc815\ud588\ub2e4.","IRBANK\uc758 2026-08-21 33.26\ubc30\u00b77\uc6d4 \ub9d0 28\ubc30\ub300 \ud45c\uc2dc \uc608\uc0c1 PER\ub85c 34\ubc30\u00b728\ubc30 \ubbfc\uac10\ub3c4\uc758 \uc575\ucee4\ub97c \ubcf4\uac15\ud558\uace0 \ud68c\uc0ac \uacf5\uc2dc EPS\uc640 \uc81c\uacf5\uc0ac EPS\uc758 \ubd84\ubaa8 \ucc28\uc774\ub97c \uba85\uc2dc\ud588\ub2e4.","Yahoo chart API\uc758 7,438~11