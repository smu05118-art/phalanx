d\ub09c\ub2e4. 2026-07 \uc218\uce58 18,447\u767e\u4e07\u5186\uc740 jp_monthly\uac00 \uc544\ub2c8\ub77c 7\u6708\u5ea6 \u901f\u5831 PDF(doc 140120260817521762)\uc5d0\uc11c \uc9c1\uc811 \uc2e4\uce21\ud574 \ubcf4\uc644\ud55c \uac83\uc774\ub2e4.","\u901f\u5831\u6570\u5024\ub294 PDF \uc6d0\ubb38 \uc8fc\uc11d\ub300\ub85c \u300c\u4f1a\u8a08\u58eb\u306e\u76e3\u67fb\u3092\u53d7\u3051\u3066\u3044\u306a\u3044\u6708\u6b21\u6570\u5024\u300d\uc774\uba70 \u524d\u5e74\u6bd4\ub3c4 \uc6d4\ucc28 \uae30\uc900 \ube44\uad50\ub2e4. \ud655\uc815 \uc2e4\uc801\uce58\uac00 \uc544\ub2c8\ub2e4.","3Q \ub2e8\ub3c5 \ubc29\ud5a5\uc131\uc740 \uc5b4\ub514\uae4c\uc9c0\ub098 \ub2e8\uccb4 \uc8fc\ucc28\uc7a5 \uc6d4\ucc28\uc5d0\uc11c \ub3c4\ucd9c\ud55c \ucd94\uc815\uc774\ub2e4. \uc5f0\uacb0 3Q \uc601\uc5c5\uc774\uc775\uc740 \ub2e8\uccb4 \u30bf\u30a4\u30e0\u30ba\u30d1\u30fc\u30ad\u30f3\u30b0 \u58f2\u4e0a\u7dcf\u5229\u76ca\uc5d0\uc11c \uc9c1\uc811 \uc0b0\ucd9c\ud560 \uc218 \uc5c6\uc73c\uba70(\ubcf8\uc0ac\ube44\u00b7\ubaa8\ube44\ub9ac\ud2f0\u00b7\ud574\uc678\u00b7\uc870\uc815\uc561 \ubbf8\ubc18\uc601), \ubcf8 \uce74\ub4dc\ub294 3Q \uc5f0\uacb0 \uc2e4\uc801 \uc218\uce58\ub97c \uc81c\uc2dc\ud558\uc9c0 \uc54a\ub294\ub2e4.","jp_monthly note\uc5d0 2024-11 \uae30\uc900\ubcc0\uacbd \ub2e8\uc808(\ud68c\uacc4\uc218\uc815 \ud6c4 \u8abf\u6574\u984d \ud3ec\ud568, +\uc57d 2.3%)\uc774 \uae30\uc7ac\ub3fc \uc788\ub2e4. \ub2e4\ub9cc \ubcf8 \uce74\ub4dc\uc758 YoY \ube44\uad50\ucc3d(2025-05~07 vs 2026-05~07)\uc740 \uc591\ucabd \ubaa8\ub450 \ub2e8\uc808 \uc774\ud6c4 \uad6c\uac04\uc774\ubbc0\ub85c \uc774 \ub2e8\uc808\uc758 \uc601\ud5a5\uc744 \ubc1b\uc9c0 \uc54a\ub294\ub2e4.","\ud68c\uacc4\uc5f0\ub3c4\uac00 10\u6708\u671f\ub77c FY \uc81c3\ubd84\uae30(\ub204\uacc4 2025-11-01~2026-07-31, \ub2e8\ub3c5 2026-05~07)\uc640 \uce98\ub9b0\ub354 \ub77c\ubca8 2026-Q3(7~9\uc6d4)\uac00 \uc5b4\uae0b\ub09c\ub2e4. \ubc1c\ud45c\uc77c \u221245\uc77c \uaddc\uce59\uc0c1 \ub77c\ubca8\uc740 2026-Q3\uac00 \ub9de\uc9c0\ub9cc \uc2e4\uc81c \ub300\uc0c1 \uae30\uac04\uc740 \ub2e4\ub974\ub2e4.","\ucee8\uc13c\uc11c\uc2a4\uc758 \ub808\uc9c0\uc2a4\ud2b8\ub9ac \uc9c0\uc815 \uc18c\uc2a4 minkabu\u00b7kabutan\uc740 \uc591\ucabd \ub2e4 WebFetch HTTP 403\uc73c\ub85c \ud655\ubcf4 \uc2e4\ud328\ud588\ub2e4. \uae30\uc7ac\ud55c \uc218\uce58\ub294 kabuyoho(IFIS \u682a\u4e88\u5831, 2026-08-21) \ub300\uccb4 \uc2e4\uce21\uce58\uc774\uba70 \uc9c0\uc815 \uc18c\uc2a4\uc640 \ucd9c\ucc98\uac00 \ub2e4\ub974\ub2e4. \uc560\ub110\ub9ac\uc2a4\ud2b8 \uc218\ub294 \ud574\ub2f9 \ud398\uc774\uc9c0\uc5d0 \uba85\uc2dc\ub3fc \uc788\uc9c0 \uc54a\uc544 \ubbf8\ud655\ubcf4\ub2e4.","\ud68c\uc0ac \ud1b5\uae30 \uc5c5\uc801\uc608\uc0c1(411,000/42,500/39,500/44,000)\uc740 \uac00\uc774\ub358\uc2a4\uc774\uc9c0 \ucee8\uc13c\uc11c\uc2a4\uac00 \uc544\ub2c8\ub2e4. \ubcf8 \uce74\ub4dc\uc5d0\uc11c \uc591\uc790\ub97c \ubd84\ub9ac \ud45c\uae30\ud588\uc73c\uba70 \uc9c4\ucc99\ub960\uc758 \ubd84\ubaa8\ub85c\ub294 2026-06-15 \uc218\uc815 \ud6c4 \uac00\uc774\ub358\uc2a4\ub97c \uc0ac\uc6a9\ud588\ub2e4.","\u4e0b\u671f \uc601\uc5c5\uc774\uc775 +15.7% YoY, \uc9c4\ucc99\ub960, GPM \ud3b8\ucc28, \ubaa8\ube44\ub9ac\ud2f0 \ud68c\uc6d0/\ucc28\ub7c9 \uc99d\uac00\uc728 \ub300\ube44 \ub4f1\uc740 \ubaa8\ub450 \ud544\uc790 \uacc4\uc0b0\uce58\uc774\uba70 \ud68c\uc0ac \uacf5\ud45c\uce58\uac00 \uc544\ub2c8\ub2e4(\ubcf8\ubb38 \u300c(\uacc4\uc0b0)\u300d \ud45c\uae30).","\u99d0\u8eca\u5834\u4e8b\u696d\u6d77\u5916\ub294 \ud574\uc678 \uc790\ud68c\uc0ac \uc5f0\uacb0\ub300\uc0c1\uae30\uac04\uc774 1\uac1c\uc6d4 \uc774\uc6d4(\u4e2d\u9593\u671f\uc758 \uacbd\uc6b0 2025-10-01~2026-03-31)\uc774\ub77c \uad6d\ub0b4\uc640 \uae30\uac04\uc774 \uc5b4\uae0b\ub09c\ub2e4. \uc601\uad6d\u00b7\uc2f1\uac00\ud3ec\ub974 \uc774\ud0c8 \ud6a8\uacfc\uac00 \u4e0b\u671f \uc2e4\uc801\uc5d0 \uc5b4\ub5a4 \uc2dc\ucc28\ub85c \ubc18\uc601\ub418\ub294\uc9c0\ub294 \u77ed\u4fe1\ub9cc\uc73c\ub85c \uc815\ubc00 \ubd84\ub9ac\ub418\uc9c0 \uc54a\ub294\ub2e4.","\uac00\uc774\ub358\uc2a4 \uc21c\uc774\uc775 44,000\u767e\u4e07\u5186\uacfc \ucee8\uc13c \uc21c\uc774\uc775 39,414\u767e\u4e07\u5186\uc740 \ubaa8\ub450 31,087\u767e\u4e07\u5186 \uc77c\ud68c\uc131 \uc138\uae08\uc775\uc744 \ud3ec\ud568\ud558\ubbc0\ub85c \uc774\uc5d0 \uae30\ubc18\ud55c PER(7.9\ubc30\u00b78.8\ubc30)\uc740 \uc2e4\uc9c8 \ubc38\ub958\ub97c \uacfc\uc18c \ud45c\uc2dc\ud55c\ub2e4. \ubcf8 \uce74\ub4dc\ub294 \uc218\uc815 \u524d \uac00\uc774\ub358\uc2a4 \uc21c\uc774\uc775 26,000\u767e\u4e07\u5186(EPS 152.31\u5186)\uc744 \uc815\uc0c1\ud654 \ub300\uc6a9\uce58\ub85c \uc37c\uc744 \ubfd0 \ud68c\uc0ac\uac00 \uacf5\ud45c\ud55c \uc815\uc0c1\ud654 \uc774\uc775\uc774 \uc544\ub2c8\ub2e4.","3Q \ub2e8\ub3c5 \uc5f0\uacb0 \uc601\uc5c5\uc774\uc775\u00b7\ucee8\uc13c\uc11c\uc2a4\uc758 \ubd84\uae30 \ube0c\ub808\uc774\ud06c\ub2e4\uc6b4\u00b7\uc2e4\uc801 \ucee8\uc13c\uc11c\uc2a4\uc758 \uc560\ub110\ub9ac\uc2a4\ud2b8 \ucee4\ubc84\ub9ac\uc9c0 \uc218\u00b7\ubaa9\ud45c\uc8fc\uac00 \uc0b0\uc815 \uadfc\uac70\ub294 \ud655\ubcf4\ud558\uc9c0 \ubabb\ud588\ub2e4.","IFIS \ubaa9\ud45c\uc8fc\uac00 2,850\u5186\uc758 \uac1c\ubcc4 \uc0b0\uc815\uc2dd\uc774 \uacf5\uac1c\ub418\uc9c0 \uc54a\uc544 \u4e0b\u671f \uc601\uc5c5\uc774\uc775 +15.7% \ub2ec\uc131\uc744 \uc804\uc81c\ub85c \ud55c\ub2e4\uace0 \ucd94\ub860\ud560 \uc218 \uc5c6\ub2e4. \ubcf8 \uce74\ub4dc\uac00 \uc774\ub97c base\ub85c \ucc44\ud0dd\ud558\uc9c0 \uc54a\uc740 \uadfc\uac70\ub294 \uc0b0\uc815 \uadfc\uac70 \ubd80\uc7ac\uc640 \uc77c\ud68c\uc131 \uc138\uae08\uc775\uc5d0 \ub530\ub978 \ud45c\uba74 EPS \uc65c\uace1\uc774\ub2e4."],"review_meta":{"reviewed_on":"2026-08-28","model":"gpt-5.6-sol/ultra","verdict":"upgraded","changes":["TDnet 7\uc6d4\ub3c4 PDF \uc7ac\uac80\uc99d \u2014 5~7\uc6d4 \ud45c\uc2dc \uc6d4\uac12 \ud569\uacc4(\ub9e4\ucd9c 53,092\u00b7\ub9e4\ucd9c\ucd1d\uc774\uc775 14,359\ubc31\ub9cc\uc5d4)\uc640 \ud68c\uc0ac \u4e0b\u671f \uc9d1\uacc4\uc5f4(53,093\u00b714,360\ubc31\ub9cc\uc5d4)\uc758 1\ubc31\ub9cc\uc5d4 \ubc18\uc62c\ub9bc \ucc28\uc774\ub97c JSON\u00b7MD\uc5d0 \ud568\uaed8 \uba85\uc2dc\ud588\ub2e4.","\ubaa8\ube44\ub9ac\ud2f0 \ub17c\ub9ac \uad50\uc815 \u2014 \uc911\uac04\uae30 \u77ed\u4fe1\uac00 4\uc6d4\ub9d0\uc5d0 \uc774\ubbf8 \ud68c\uc6d0 \uc99d\uac00\uc728 117.5%\ub85c \uc804\uc6a9\ucc28\ub7c9 117.3%\ub97c \uadfc\uc18c\ud558\uac8c \uc55e\uc130\ub2e4\uace0 \ubc1d\ud788\ubbc0\ub85c, 3Q\uc758 \uc2e0\uaddc '\uc5ed\uc804'\uc744 \uae30\uc874 \uc6b0\uc704\uc758 \ud655\ub300\ub85c \ubc14\ub85c\uc7a1\uc558\ub2e4.","\ubc38\ub958 \uadfc\uac70 \uc0ac\uc2ac \uad50\uc815 \u2014 \uc0b0\uc815\uc2dd\uc774 \uacf5\uac1c\ub418\uc9c0 \uc54a\uc740 IFIS \ubaa9\ud45c\uc8fc\uac00 2,850\uc5d4\uc774 \u4e0b\u671f OP +15.7% \ub2ec\uc131\uc744 \uc804\uc81c\ud55c\ub2e4\ub294 \ub2e8\uc815\uc744 \uc81c\uac70\ud558\uace0, \uc0b0\uc815 \uadfc\uac70 \ubd80\uc7ac\uc640 \uc77c\ud68c\uc131 \uc138\uae08\uc775\uc5d0 \ub530\ub978 \ud45c\uba74 EPS \uc65c\uace1\ub9cc \ube44\ucc44\ud0dd \uadfc\uac70\ub85c \ub0a8\uacbc\ub2e4.","\uc0b0\uc220 \uc815\ubc00\ud654 \u2014 2,038\uc5d4 \ub300\ube44 2,285\uc5d4/1,828\uc5d4\uc758 \uc5c5\u00b7\ub2e4\uc6b4\uc0ac\uc774\ub4dc\ub97c +12.1%/-10.3%, 52\uc8fc \ubc34\ub4dc \ub0b4 \uc704\uce58\ub97c 53.6%\ub85c \uc7ac\uacc4\uc0b0\ud574 \ud544\ub4dc\uc640 \uc11c\uc220\uc744 \ub3d9\uae30\ud654\ud588\ub2e4."],"recalc_check":{"upside":{"method":"price_target","price_base":2038,"price_src":"jem_data/preview/_batch/px_4666.T.json \u2014 Yahoo chart API \uc2e4\uce21 2026-08-21 \uc885\uac00 2,038\u5186","targets":{"base":2285,"bull":null,"bear":1828}},"consensus":{"value":41036,"own":42500,"unit":"\u767e\u4e07\u5186, FY2026/10 \ud1b5\uae30 \uc601\uc5c5\uc774\uc775","formula":"value_over_own","note":"IFIS\uc758 FY2026/10 \uc601\uc5c5\uc774\uc775 \ucee8\uc13c\uc11c\uc2a4 41,036\ubc31\ub9cc\uc5d4\uacfc \ud68c\uc0ac \uc218\uc815 \uac00\uc774\ub358\uc2a4 42,500\ubc31\ub9cc\uc5d4\uc740 \uac19\uc740 \uae30\uac04\u00b7\uc9c0\ud45c\u00b7\ub2e8\uc704\uc774\uba70, gap_pct\ub294 \ucee8\uc13c\uc11c\uc2a4\uac00 \ud68c\uc0ac \uac00\uc774\ub358\uc2a4\ubcf4\ub2e4 \uc5bc\ub9c8\ub098 \ub0ae\uc740\uc9c0\ub97c \ub73b\ud55c\ub2e4."},"verdict":"pass"}},"md":"# \u30d1\u30fc\u30af\uff12\uff14 (Park24 \u00b7 4666.T) \u2014 2026-Q3 **\ud504\ub9ac\ubdf0**\n\n\u003e \ubcf8 \ubb38\uc11c\ub294 **\ud22c\uc790\ud310\ub2e8 \ucc38\uace0\uc6a9**\uc774\uba70 \ud22c\uc790 \uad8c\uc720\uac00 \uc544\ub2d9\ub2c8\ub2e4. \uc791\uc131 2026-08-23 \u00b7 tier=standard\n\n## 1. \uae30\uc5c5\ud655\uc778 \u00b7 \ubc1c\ud45c\uc77c \uadfc\uac70\n\n| \ud56d\ubaa9 | \uac12 |\n|---|---|\n| \ud2f0\ucee4/\uc0ac\uba85 | `4666.T` / \u30d1\u30fc\u30af\uff12\uff14\u682a\u5f0f\u4f1a\u793e (\u6771\u8a3c\u30d7\u30e9\u30a4\u30e0) |\n| \ubb38\uc11c\uc720\ud615 | **preview** (\ubc1c\ud45c \uc804, D-8) |\n| \ubc1c\ud45c \uc608\uc815\uc77c | **2026-08-31** \u2014 \ud68c\uc0ac IR\u300cIR\u30ab\u30ec\u30f3\u30c0\u30fc\u300d\uc2e4\uce21: \ub2f9\uc77c\u300c\u7b2c3\u56db\u534a\u671f\u6c7a\u7b97\u767a\u8868\u300d+\u300c\u30a2\u30ca\u30ea\u30b9\u30c8\u30fb\u6a5f\u95a2\u6295\u8cc7\u5bb6\u5411\u3051 \u7b2c3\u56db\u534a\u671f\u6c7a\u7b97\u8aac\u660e\u4f1a\u300d 2\uac74 \uac8c\uc7ac (park24.co.jp/ir/calendar.html). \uc2a4\ud399 \uce98\ub9b0\ub354 \uc18c\uc2a4 `ecal_jp` \uc640 \uc77c\uce58 |\n| \uce98\ub9b0\ub354 \uc815\ud569 | 2026-08-31 \u2212 45\uc77c = 2026-07-17 \u2192 **2026-Q3 \u2705** (`PERIOD_LAG_DAYS=45`) |\n\n\u26a0\ufe0f **10\u6708\u671f\u6c7a\u7b97\u793e**\ub2e4. \uc774\ubc88\uc5d0 \ub098\uc62c \uac83\uc740 FY2026/10 **\uc81c3\ubd84\uae30 \ub204\uacc4 = 2025-11-01~2026-07-31**, **3Q \ub2e8\ub3c5 = 2026-05~07**. \uce98\ub9b0\ub354 \ub77c\ubca8 2026-Q3(7~9\uc6d4)\uc640 \ud68c\uacc4\ubd84\uae30\uac00 \uc5b4\uae0b\ub09c\ub2e4.\n\n## 2. 3Q \ub2e8\ub3c5 \ucc3d\uc740 \uc6d4\ucc28\ub85c \uc774\ubbf8 \ub2e4 \uacf5\uac1c\ub410\ub2e4 (\ucd5c\ub300 \ubb34\uae30)\n\n\u4f1a\u793e \uac1c\uc2dc\u300c\u901f\u5831\u6570\u5024\u300d5\u00b76\u00b77\uc6d4\u5ea6 = FY 3Q \ub2e8\ub3c5 \uadf8\ub300\ub85c. **7\uc6d4\u5ea6(2026-08-17 \uac1c\uc2dc, doc 140120260817521762) \ud30c\uc2f1 \uc131\uacf5.**\n\n**\u30bf\u30a4\u30e0\u30ba\u30d1\u30fc\u30ad\u30f3\u30b0(\u30d1\u30fc\u30af24\u5358\u4f53, \u767e\u4e07\u5186)**\n\n| | 5\u6708 | 6\u6708 | 7\u6708 | **\ud45c\uc2dc \uc6d4\uac12 \ud569\uacc4** |\n|---|---|---|---|---|\n| \u58f2\u4e0a\u9ad8 25\u5e74 | 15,794 | 15,992 | 16,941 | 48,727 |\n| \u58f2\u4e0a\u9ad8 26\u5e74 | 17,317 | 17,328 | **18,447** | **53,092** |\n| \u524d\u5e74\u6bd4(\uacf5\ud45c) | 109.6% | 108.3% | 108.9% | **109.0%** |\n| \u58f2\u4e0a\u7dcf\u5229\u76ca 26\u5e74 | 4,518 | 4,426 | 5,415 | **14,359** |\n| \u7c97\u5229 \u524d\u5e74\u6bd4 | 108.5% | **102.3%** | 107.9% | **106.3%** |\n| \u58f2\u4e0a\u7dcf\u5229\u76ca\u7387 | 26.1% | 25.5% | 29.4% | **27.0% (\u25b30.7pt)** |\n\n\ud45c\uc758 \uc6d4\ubcc4 \ud45c\uc2dc\uac12\uc744 \ub354\ud558\uba74 \u58f2\u4e0a\u9ad8 **53,092**\u00b7\u58f2\u4e0a\u7dcf\u5229\u76ca **14,359**\u767e\u4e07\u5186\uc774\ub2e4. \ud68c\uc0ac PDF\uc758 \u4e0b\u671f \uc9d1\uacc4\uc5f4\uc740 \uac01\uac01 **53,093**\u00b7**14,360**\u767e\u4e07\u5186\uc73c\ub85c 1\u767e\u4e07\u5186\uc529 \ud06c\ub2e4. \uc774\ub294 \u767e\u4e07\u5186 \ub2e8\uc704\ub85c \ud45c\uc2dc\ub41c \uc6d4\uac12\uc744 \ub2e4\uc2dc \ud569\uc0b0\ud560 \ub54c \uc0dd\uae30\ub294 \ubc18\uc62c\ub9bc \ucc28\uc774\uc774\ubbc0\ub85c, \uc6d4\uac12 \ud569\uacc4\uc640 \ud68c\uc0ac \uc9d1\uacc4\uc5f4\uc744 \uad6c\ubd84\ud55c\ub2e4.\n\n\u4e0a\u671f(11~4\u6708) \ub300\ube44: \ub9e4\ucd9c 109.8%\u2192**109.0%**, \u7c97\u5229 108.4%\u2192**106.3%**, GPM \ud3b8\ucc28 \u25b30.3pt\u2192**\u25b30.7pt**. \ub9e4\ucd9c\uc740 +9%\ub300\ub97c \uc9c0\ucf30\uc9c0\ub9cc **\uc6d0\uac00\uac00 110.0%\ub85c \ub9e4\ucd9c\uc744 \uc55e\uc9c8\ub7ec \ub9c8\uc9c4\uc774 \uae4e\uc774\ub294 \uc911**\uc774\ub2e4. 6\uc6d4 \u7c97\u5229 +2.3%\uac00 \uc800\uc810, 7\uc6d4 +7.9%\ub85c \ubc18\ub4f1.\n\n\uc131\uc7a5\uc758 \uc9c8\ub3c4 \ubd10\uc57c \ud55c\ub2e4. \u30b9\u30bf\u30f3\u30c0\u30fc\u30c9\u5360\u6709\u7387\uc740 5/6/7\uc6d4 48.4%/49.3%/49.8%\ub85c **\uc804\ub144\u6bd4 \u25b31.5/\u25b31.3/\u25b31.2pt \uc804\ubd80 \ub9c8\uc774\ub108\uc2a4**\ub2e4. \uc989 +9% \ub9e4\ucd9c\uc740 \u7a3c\u50cd\u7387\uc774 \uc544\ub2c8\ub77c **\u53f0\u6570 \ud655\ub300**(7\uc6d4\ub9d0 749,771\u53f0, \uc804\uae30\ub9d0\u6bd4 +7.5%)\uc640 \ub2e8\uac00\uac00 \ub9cc\ub4e0 \uac83\uc774\ub2e4.\n\n**\u30e2\u30d3\u30ea\u30c6\u30a3(\u30bf\u30a4\u30e0\u30ba\u30ab\u30fc) \u2014 \ud68c\uc6d0 \uc99d\uac00 \uc6b0\uc704\uac00 \ud655\ub300\ub41c \ud3ec\uc778\ud2b8.** 7\uc6d4\ub9d0 \ud68c\uc6d0 4,057\u5343\u4eba(\uc804\uae30\ub9d0\u6bd4 +12.2%), \u5c02\u7528\u8eca\u4e21 69,733\u53f0. \uc911\uac04\uae30\ub9d0(4\uc6d4\ub9d0) \ub300\ube44 **\ud68c\uc6d0 +5.3% vs \u5c02\u7528\u8eca\u4e21 +4.1%\ub85c \ud68c\uc6d0 \uc99d\uac00 \uc6b0\uc704\uac00 \ud655\ub300\ub410\ub2e4.** \uc0c1\ubc18\uae30 6\uac1c\uc6d4\uac04 \ud68c\uc6d0 \uc99d\uac00 +234\u5343\u4eba\uc778\ub370 5~7\uc6d4 3\uac1c\uc6d4\ub9cc\uc5d0 +206\u5343\u4eba \u2014 \ud68d\ub4dd \ud398\uc774\uc2a4\uac00 \ub69c\ub837\uc774 \uac00\uc18d. \ub2e4\ub9cc \u4e2d\u9593\u671f \u77ed\u4fe1\ub294 \uc774\ubbf8 4\uc6d4\ub9d0 \uc804\ub144\ub3d9\uae30\ube44\uc5d0\uc11c \ud68c\uc6d0 117.5%\uac00 \u5c02\u7528\u8eca\u4e21 117.3%\ub97c \uadfc\uc18c\ud558\uac8c \uc55e\uc130\ub2e4\uace0 \ubc1d\ud614\ub2e4. \ub530\ub77c\uc11c 3Q\uac00 \uc0c8\ub85c \ub9cc\ub4e0 \uc5ed\uc804\uc774 \uc544\ub2c8\ub77c 3\uc6d4\ub9d0\uae4c\uc9c0\uc758 \uc5f4\uc704\ub97c 4\uc6d4\uc5d0 \ub4a4\uc9d1\uc740 \ub4a4 5~7\uc6d4\uc5d0 \uaca9\ucc28\ub97c \ub113\ud78c \uac83\uc774\uba70, \uc2e4\uc81c \u7a3c\u50cd\u00b7\uc774\uc775 \uac1c\uc120 \uc5ec\ubd80\ub294 3Q \uc2e4\uc801\uc73c\ub85c \ud655\uc778\ud574\uc57c \ud55c\ub2e4.\n\n## 3. \uc9c1\uc804 \uc2e4\uc801 \uc5f0\uacb0 (FY2026/10 \u4e2d\u9593\u671f \u00b7 2026-06-15 \ubc1c\ud45c)\n\n\u77ed\u4fe1 doc `140120260612569710` \uc2e4\uce21 \u2014 \u58f2\u4e0a\u9ad8 **202,275**\u767e\ub9cc\uc5d4(+4.6%) / \u55b6\u696d\u5229\u76ca **17,295**(+9.6%) / \u7d4c\u5e38\u5229\u76ca **15,730**(+13.0%) / \u4e2d\u9593\u7d14\u5229\u76ca **29,657**(+495.3%).\n\uc138\uadf8\uba3c\ud2b8: \u99d0\u8eca\u5834\u56fd\u5185 105,150(+9.1%)\u00b7OP 18,060(+4.3%) / \u30e2\u30d3\u30ea\u30c6\u30a3 66,688(+11.7%)\u00b7OP **5,917(+1.8%)** / \u99d0\u8eca\u5834\u6d77\u5916 33,894(\u25b317.0%)\u00b7OP **+224**(\uc804\ub144 \u25b3982).\n\n**\uc601\uad6d \ud30c\uc0b0\uc774 \uc774 \ubd84\uae30\uc758 \uc804\ubd80\ub2e4.** 2026-03-16 \u300c\u82f1\u56fd\u5b50\u4f1a\u793e\u306b\u3088\u308b\u5012\u7523\u66f4\u751f\u624b\u7d9a\u304d\u306e\u958b\u59cb\u300d(doc 140120260316582566) \u2192 NATIONAL CAR PARKS \ub4f1 4\uc0ac \uc5f0\uacb0 \uc81c\uc678 + \uc2f1\uac00\ud3ec\ub974 \ub9e4\uac01. \u7279\u5225\u640d\u5931 8,724 + 3,302\u767e\u4e07, \ubc18\ub300\ud3b8\uc5d0 **\u6cd5\u4eba\u7a0e\u7b49\u8abf\u6574\u984d(\u76ca) 31,087\u767e\u4e07** \u2014 \uc21c\uc774\uc775 \ud3ed\uc99d\uc740 \uc804\ubd80 \uc774 \uc77c\ud68c\uc131 \uc138\uae08\uc774\ub2e4.\n\n\u26a0\ufe0f **\ubaa8\ube44\ub9ac\ud2f0\uac00 \ub9e4\ucd9c +11.7%\uc5d0 OP +1.8%(OPM 9.7%\u21928.9%)\ub85c \uc0ac\uc2e4\uc0c1 \uc81c\uc790\ub9ac**\uc600\ub2e4\ub294 \uac8c \uc0c1\ubc18\uae30\uc758 \uc2e4\ub9dd \ud3ec\uc778\ud2b8\ub2e4. \uc0c1\ubc18\uae30 OP \uc99d\uac00 +1,514 \uc911 +1,207\uc774 \ud574\uc678 \ud134\uc5b4\ub77c\uc6b4\ub4dc\uc600\ub2e4.\n\n## 4. \uc218\uc815 \ud6c4 \ud1b5\uae30 \uac00\uc774\ub358\uc2a4 \ub300\ube44 \uc9c4\ucc99\ub960 (\uacc4\uc0b0)\n\n\uac00\uc774\ub358\uc2a4\ub294 2026-06-15 \uc7ac\uc218\uc815\ub428(doc `140120260615570538`): \u58f2\u4e0a 410,000\u2192**411,000** / \u55b6\u696d 41,500\u2192**42,500** / \u7d4c\u5e38 38,500\u2192**39,500** / \u7d14\u5229 26,000\u2192**44,000**(EPS 257.76\u5186) \u00b7 \u914d\u5f53 30\u2192**65\u5186**.\n\n| | \u4e2d\u9593\u671f \uc2e4\uc801 | \ud1b5\uae30 \uc218\uc815\uc608\uc0c1 | \uc9c4\ucc99\ub960(\uacc4\uc0b0) | FY25 \ub3d9\uc77c\uc2dc\uc810 |\n|---|---|---|---|---|\n| \u58f2\u4e0a\u9ad8 | 202,275 | 411,000 | **49.2%** | 47.6% |\n| \u55b6\u696d\u5229\u76ca | 17,295 | 42,500 | **40.7%** | 42.0% |\n| \u7d4c\u5e38\u5229\u76ca | 15,730 | 39,500 | **39.8%** | 40.7% |\n| \u7d14\u5229\u76ca | 29,657 | 44,000 | 67.4% | \u2014 |\n\n**\ub9e4\ucd9c \uc9c4\ucc99\uc740 \uc55e\uc11c\ub294\ub370 \uc774\uc775 \uc9c4\ucc99\uc740 \ub4a4\uc9c4\ub2e4.** \uc5ed\uc0b0\ud558\uba74 \u4e0b\u671f(5~10\u6708)\ub294 \ub9e4\ucd9c 208,725(**\u25b31.9% YoY**, \uc601\uad6d\u00b7\uc2f1\uac00\ud3ec\ub974 \uc774\ud0c8\ubd84)\uc5d0 **\u55b6\u696d\u5229\u76ca 25,205 = +15.7% YoY**\ub97c \ub0b4\uc57c \ud55c\ub2e4(\uacc4\uc0b0). \uc0c1\ubc18\uae30 OP \uc99d\uac00\uc728 +9.6%\uc5d0\uc11c \ud55c \ub2e8\uacc4 \ub354 \uac00\uc18d\ud574\uc57c \ud558\ub294 \uc148\uc774\ub2e4. \uad6d\ub0b4 \uc8fc\ucc28\uc7a5 \u7c97\u5229\uac00 3Q\uc5d0 +6.3%\ub85c \uac10\uc18d\ud55c \uc0c1\ud0dc\ub77c, \uc774 \uac2d\uc740 \u2460\uc601\uad6d \uc801\uc790 \uc18c\uba78\uc758 \uae30\uc800\ud6a8\uacfc \u2461\ubaa8\ube44\ub9ac\ud2f0 \u7a3c\u50cd \ubc18\ub4f1, \uc774 \ub458\ub85c \uba54\uc6cc\uc57c \ud55c\ub2e4.\n\n## 5. \ud310\uc815 \u00b7 \ucee8\uc13c \u00b7 \ubc38\ub958\uc5d0\uc774\uc158\n\n**\ud310\uc815: \uc911\ub9bd.** 3Q \uc6d4\ucc28\ub294 \ud1b1\ub77c\uc778 +9%\uc640 \ubaa8\ube44\ub9ac\ud2f0 \ud68c\uc6d0 \uc99d\uac00 \uc6b0\uc704 \ud655\ub300\ub77c\ub294 \uc88b\uc740 \uadf8\ub9bc\uc744 \uc8fc\uc9c0\ub9cc, \ub3d9\uc2dc\uc5d0 **\uad6d\ub0b4 \u7c97\u5229 \uac10\uc18d(+6.3%)\u00b7GPM \u25b30.7pt\u00b7\u5360\u6709\u7387 \uc804\ub144 \ubbf8\ub2ec**\uc774 \uac19\uc774 \ucc0d\ud614\ub2e4. \ud1b5\uae30 \uac00\uc774\ub358\uc2a4\uac00 \uc694\uad6c\ud558\ub294 \u4e0b\u671f OP +15.7%\ub294 \uc0c1\ubc18\uae30 \ubaa8\ube44\ub9ac\ud2f0 \uc2e4\uc801(+1.8%)\uc73c\ub85c\ub294 \uc544\uc9c1 \ub4b7\ubc1b\uce68\ub418\uc9c0 \uc54a\ub294\ub2e4. \uc8fc\uac00\ub294 6\uc6d4 \uc0c1\ud5a5\u00b7\uc99d\ubc30\ub97c \uc774\ubbf8 3M +13.95%\ub85c \ubc18\uc601\ud588\ub2e4.\n\n**\ucee8\uc13c\uc11c\uc2a4 vs \ud68c\uc0ac \uac00\uc774\ub358\uc2a4\ub294 \uad6c\ubd84\ud574\uc57c \ud55c\ub2e4.** \ub808\uc9c0\uc2a4\ud2b8\ub9ac \uc9c0\uc815 minkabu\u00b7kabutan\uc740 **\uc591\ucabd \ub2e4 WebFetch 403**. \ub300\uccb4\ub85c kabuyoho(IFIS \u682a\u4e88\u5831, 2026-08-21 \