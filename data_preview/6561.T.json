. minkabu \ubaa9\ud45c\uc8fc\uac00 1,282\u5186\u00b7'\u5272\u5b89' \uc9c4\ub2e8\uc740 \uc54c\uace0\ub9ac\uc998 \uc0b0\ucd9c\uce58\ub85c \ucee8\uc13c\uc11c\uc2a4\uac00 \uc544\ub2c8\ub2e4.","\uc5c5\u00b7\ub2e4\uc6b4\uc0ac\uc774\ub4dc\ub294 \ud68c\uc0ac \uac00\uc774\ub358\uc2a4 EPS\uc640 \uc784\uc758\uc758 PER \ubc34\ub4dc(8.5\ubc30/6.5\ubc30)\uc5d0 \uae30\ubc18\ud55c \ub2e8\uc21c \uacc4\uc0b0\uc73c\ub85c, \uac80\uc99d\ub41c \ubaa9\ud45c\uc8fc\uac00\uac00 \uc544\ub2c8\ub2e4. \ud2b9\ud788 \uc911\uad6d \uc815\ubd80\uc758 \u5c0d\u65e5 \ub3c4\ud56d\uc790\uc219 \uc694\uccad\uacfc \uc911\ub3d9\uc815\uc138\ub294 \ud68c\uc0ac\uac00 \ud1b5\uc81c\ud560 \uc218 \uc5c6\ub294 \uc678\ubd80 \ubcc0\uc218\uc774\uba70 \ud574\uc18c \uc2dc\uc810\uc774 \ubd88\ud655\uc2e4\ud558\ub2e4. T\ub9c8\ud06c\uc2dc\ud2f0\ud638\ud154\u672d\u5e4c \uc7ac\uac1c\ubc1c \uacc4\ud68d\ub3c4 \ubbf8\ud655\uc815(\u88dc\u8db3\u8cc7\u6599 '\u6c7a\u5b9a\u6b21\u7b2c\u65e9\u671f\u958b\u793a')\uc774\ub77c \ud558\ubc18\uae30 \uc774\uc775 \ucd94\uc815\uc5d0 \ubc18\uc601\ud558\uc9c0 \uc54a\uc558\ub2e4.","1H \uc774\ud6c4(2026\ub144 8\uc6d4 \uc774\ud6c4) \uc6d4\ucc28\ub294 \uc544\uc9c1 \ubbf8\uac1c\uc2dc\ub85c, \ucd5c\uc2e0 \uc2e4\uce21 \ub370\uc774\ud130 \ud3ec\uc778\ud2b8\ub294 2026\ub144 7\uc6d4\uc774 \ub05d\uc774\ub2e4.","priced_in.pct_est=65\ub294 \uc815\ub7c9 \ubaa8\ub378 \uc0b0\ucd9c\uac12\uc774 \uc544\ub2c8\ub2e4. 3M +6.52% \ubc18\ub4f1\uacfc \ubc1c\ud45c\uc77c \uc885\uac00 \uc774\ud6c4 -2.2% \ubc18\uc751\uc744 \ud568\uaed8 \ubcf8 \uc8fc\uad00\uc801 \ucd94\uc815\uce58\uc774\uba70, \ubc1c\ud45c \uc9c1\ud6c4 \ubc18\uc751\uc740 8/14 \uc885\uac00 835\u5186\uc744 \uae30\uc900\uc73c\ub85c \uacc4\uc0b0\ud588\ub2e4."],"review_meta":{"reviewed_on":"2026-08-24","model":"gpt-5.6-sol/ultra","verdict":"upgraded","changes":["\uc6d4\ucc28 \uc6d0\uc7a5\uc744 Python\uc73c\ub85c \uc7ac\uac1c\ubc29\ud574 generated=2026-08-24, code=6561, form=abs, cover=54, span=2019-01~2026-06 \ubc0f m \uac12\uc744 \uc7ac\ud655\uc778\ud558\uace0 \ub0a1