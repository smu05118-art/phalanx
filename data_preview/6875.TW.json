price_base - 1) * 100","inputs":{"price_base":32.2,"price_src":"TPEx \uc77c\ubcc4\uc2dc\uc138 2026-08-21 \uc885\uac00 TWD 32.20","base_anchor":35.33,"bull_anchor":38.5,"bear_anchor":32.15,"base_pct_recalc":9.72,"bull_pct_recalc":19.57,"downside_pct_recalc":-0.16},"verified":true},"consensus":{"value":null,"own":null,"unit":"","formula":"own_over_value","note":"\ub808\uc9c0\uc2a4\ud2b8\ub9ac \uc9c0\uc815 \ub300\ub9cc \uc560\ub110\ub9ac\uc2a4\ud2b8 \ucee8\uc13c\uc11c\uc2a4 \ub85c\uceec \uc18c\uc2a4\uac00 \uc5c6\uc5b4 \ube44\uad50\ud560 \uc218 \uc5c6\ub2e4."},"fundamentals":{"q1_monthly_revenue_sum":1792.0,"q2_monthly_revenue_sum":0.0,"prior_year_q2_monthly_revenue_sum":15678.0,"qoq_pct_recalc":-100.0,"yoy_pct_recalc":-100.0},"priced_in":{"start_price":37.55,"end_price":32.2,"formula":"(end_price / start_price - 1) * 100","move_pct_recalc":-14.25},"forecast":{"present":false,"note":"standard_light \uc6d0\ubcf8\u00b7\uc2a4\ud0a4\ub9c8\uc5d0 forecast \ud655\ub960 \ube14\ub85d\uc774 \uc5c6\uc5b4 \uc784\uc758 \uc2dc\ub098\ub9ac\uc624 \ud655\ub960\uc744 \ub9cc\ub4e4\uc9c0 \uc54a\uc558\ub2e4."},"verdict":"pass"}},"md":"# Pharmosa Biopharm Inc. (6875.TW) 2026-Q2 \ub9ac\ubdf0\n\n\u003e \ubcf8 \ubb38\uc11c\ub294 \ud22c\uc790\ud310\ub2e8 \ucc38\uace0\uc6a9\uc774\uba70 \ud22c\uc790 \uad8c\uc720\uac00 \uc544\ub2d9\ub2c8\ub2e4.\n\n| \uae30\uc5c5\ud655\uc778 | \ub0b4\uc6a9 |\n|---|---|\n| \ud2f0\ucee4\u00b7\ubd84\uae30\u00b7\uc720\ud615 | `6875.TW` \u00b7 `2026-Q2` \u00b7 `review` |\n| \ubc1c\ud45c\uc77c \uadfc\uac70 | **2026-08-04 15:35:10**, MOPS \uc5ed\uc0ac \uc911\ub300\uc815\ubcf4\uc758 \uc774\uc0ac\ud68c \ud1b5\uacfc \uacf5\uc2dc. `ecal_tw` 2026-08-14\ub294 \ubc95\uc815 \uc2e0\uace0\uae30\ud55c |\n| \ud310\uc815 | **\uc911\ub9bd** \u2014 MOPS\ub85c \ubcf4\uc644\ud55c Q2 \uc6d4\ub9e4\ucd9c\uc740 0\uc774\uace0 H1 \uc601\uc5c5\uc190\uc2e4\uc740 NT$205,144\ucc9c\uc774\uc9c0\ub9cc, L606 \uac00\uce58\ub3d9\uc778\uc740 \ubaa8\uc9d1 \uc911\uc778 3\uc0c1\uc774\ubbc0\ub85c \uc704\ud5d8\uc870\uc815 \ud30c\uc774\ud504\ub77c\uc778 \uac00\uce58\u00b7\ud604\uae08\ub7f0\uc6e8\uc774\u00b7\uc7a0\uc7ac \ud76c\uc11d\uc744 \ubaa8\ub378\ub9c1\ud558\uc9c0 \uc54a\uc740 \uc0c1\ud0dc\uc5d0\uc11c \uc6d4\ub9e4\ucd9c\uacfc \uad00\uce21 \uc8fc\uac00\ubc34\ub4dc\ub9cc\uc73c\ub85c \ub9e4\ub3c4\ub97c \uc9c0\uc9c0\ud560 \uc218 \uc5c6\ub2e4. |\n\n| \uc2e4\uce21 \uce74\ub4dc | \uac12\u00b7\ubc29\ud5a5 | \ucd9c\ucc98 |\n|---|---|---|\n| \uc9c0\uc815 \ub85c\uceec \uc6d4\ub9e4\ucd9c | 2026-03 **NT$1,792\ucc9c**; \ub85c\uceec\uc5d0 2026-Q2 \ud0a4 \ubd80\uc7ac | `jem_data/tw_census/phalanx_ready.json#6875` |\n| MOPS \ubcf4\uc644 Q2 \uc6d4\ub9e4\ucd9c | 4\u00b75\u00b76\uc6d4 **0\u00b70\u00b70**, Q2 **0**; Q1 1,792 \ubc0f 2025-Q2 15,678 \ub300\ube44 \uac01\uac01 **-100.00%** | MOPS \uc5ed\uc0ac \uc6d4\ub9e4\ucd9c `ajax_t05st10_ifrs` |\n| \uacf5\uc2dd 2026-H1 \ub204\uc801 \uc190\uc775 | \ub9e4\ucd9c **NT$1,792\ucc9c** / \ub9e4\ucd9c\ucd1d\uc774\uc775 **NT$330\ucc9c** / \uc601\uc5c5\uc774\uc775 **NT$-205,144\ucc9c** / \uc21c\uc774\uc775 **NT$-194,297\ucc9c** / EPS **-1.50\uc6d0** | TPEx \uacf5\uc2dd API\u00b7MOPS H1 \uacf5\uc2dc |\n| Q2 \ub2e8\ub3c5 \ud30c\uc0dd\uce58 | \ub9e4\ucd9c **0** / \ub9e4\ucd9c\ucd1d\uc774\uc775 **0** / \uc601\uc5c5\uc774\uc775 **NT$-101,899\ucc9c** / \uc21c\uc774\uc775 **NT$-100,136\ucc9c**; H1 \ub204\uc801\u2212Q1 \ub204\uc801 | MOPS 2026-Q1\u00b7H1 \uc774\uc0ac\ud68c \ud1b5\uacfc \uacf5\uc2dc \ucc28\uac10 |\n| \ucd5c\uadfc 3\uac1c\uc6d4 \uc885\uac00 | 2026-05-20 **37.55** \u2192 2026-08-21 **32.20 TWD** (**-14.25%**), 66\uac1c \uad00\uce21, \ubc34\ub4dc **32.15~38.50** | TPEx 2026\ub144 5~8\uc6d4 \uc77c\ubcc4\uc2dc\uc138 |\n\n\uc9c0\uc815 \ub85c\uceec\uc740 `companies[1727]`\uc758 \uc6d4\ub9e4\ucd9c \uc0ac\uc804\uc73c\ub85c, 2026\ub144\uc740 3\uc6d4 NT$1,792\ucc9c\uc774 \uc788\uace0 1\u00b72\u00b74\u00b75\u00b76\uc6d4 \ud0a4\uac00 \uc5c6\ub2e4. MOPS \uc5ed\uc0ac \uc6d4\ub9e4\ucd9c\uc744 \ucd94\uac00 \uc2e4\uce21\ud574 \ub204\ub77d\uc6d4\uc744 \ubaa8\ub450 0\uc73c\ub85c \ud655\uc778\ud588\ub2e4. MOPS\ub294 \ud68c\uc0ac\ub97c \uc2e0\uc57d\uac1c\ubc1c\uc0ac\ub85c \uba85\uc2dc\ud558\uace0 3\uc6d4 1,792\ub97c \uc784\uc0c1\uc57d\ubb3c \uc218\uc775\uc73c\ub85c \uc124\uba85\ud55c\ub2e4. \ub530\ub77c\uc11c Q2 \uc6d4\ub9e4\ucd9c \uae09\uac10\uc740 \uc2e4\uce21 \uc0ac\uc2e4\uc774\uc9c0\ub9cc, \uc774\ub97c \uc784\uc0c1\ub2e8\uacc4 \uc2e0\uc57d\uc758 \uc704\ud5d8\uc870\uc815 \uac00\uce58\ub098 \uc131\uacf5\ud655\ub960\ub85c \ubc14\ub85c \ub300\uccb4\ud558\uc9c0 \uc54a\uc558\ub2e4.\n\n## \ucee8\uc13c\uc11c\uc2a4\u00b7priced-in\u00b7\uac00\uce58 \uc9c4\ub2e8\n\n- \ucee8\uc13c\uc11c\uc2a4: \ub808\uc9c0\uc2a4\ud2b8\ub9ac \uc9c0\uc815 \ub300\ub9cc \uc560\ub110\ub9ac\uc2a4\ud2b8 \ub85c\uceec \uc18c\uc2a4\uac00 \uc5c6\uc5b4 `value=null`, `gap_pct=null` \uc720\uc9c0.\n- Priced-in: Q2 \uc6d4\ub9e4\ucd9c 0\u00b7H1 \uc601\uc5c5\uc190\uc2e4\uacfc \uc8fc\uac00 -14.25%\ub294 \ubaa8\ub450 \ubd80\uc815\uc801\uc774\uc9c0\ub9cc, \ud30c\uc774\ud504\ub77c\uc778 \uac00\uce58 \uc0b0\uc815\uacfc \ucee8\uc13c\uc11c\uc2a4\uac00 \uc5c6\uc73c\ubbc0\ub85c \uc120\ubc18\uc601 \uc815\ub3c4\ub294 \uc815\ub7c9\ud654\ud558\uc9c0 \uc54a\uc558\ub2e4. `pct_est=-14.25` \uc5ed\uc2dc \uc120\ubc18\uc601\ub960\uc774 \uc544\ub2c8\ub77c \uc2e4\uce21 \uac00\uaca9\uc218\uc775\ub960\uc774\ub2e4.\n- \uad00\uce21 \ubc34\ub4dc \uc9c4\ub2e8: 2026-08-21 \uc885\uac00 32.20 TWD \ub300\ube44 base 35.33\uc740 **+9.72%**, bull 38.50\uc740 **+19.57%**, bear 32.15\ub294 **-0.16%**\ub2e4. \uc774\ub294 \uc8fc\uac00\ubc34\ub4dc \uc9c4\ub2e8\uce58\uc77c \ubfd0 \ub0b4\uc7ac\uac00\uce58 \ubaa9\ud45c\uac00\uac00 \uc544\ub2c8\ub2e4.\n\n## \ud504\ub808\uc784 \uc801\ud569\uc131\n\nClinicalTrials.gov `NCT07285655` \ub808\ucf54\ub4dc\ub294 2026-06-29 \ucd5c\uc885 \uac31\uc2e0 \uae30\uc900 L606 Re-Spire\ub97c **Phase 3 / Recruiting**\uc73c\ub85c \ud45c\uc2dc\ud558\uace0, \uc2e4\uc81c \uc2dc\uc791\uc77c\uc740 2026-04-23, \uc608\uc815 1\ucc28 \uc644\ub8cc\ub294 2029-07\uc774\ub2e4. \uc784\uc0c1 \uc9c4\ud589 \uc0ac\uc2e4\uc740 \uac00\uce58\ub3d9\uc778\uc774\uc9c0\ub9cc \uc131\uacf5\u00b7\ud5c8\uac00\u00b7\uc0c1\uc5c5\ud654\ub97c \uc785\uc99d\ud558\uc9c0 \uc54a\ub294\ub2e4. `standard_light`\uc758 \uc6d4\ub9e4\ucd9c\u00b73\uac1c\uc6d4 \uc8fc\uac00 \ud504\ub808\uc784\uc740 \uadfc\uac70 \ud45c\uc2dc\uc5d0\ub294 \uc720\uc6a9\ud558\uc9c0\ub9cc, L606 \uc131\uacf5\ud655\ub960\u00b7\ub9c8\uc77c\uc2a4\ud1a4\u00b7\ud604\uae08\uc18c\uc9c4\uacfc \ud544\uc694\uc790\uae08 \uacbd\ub85c\u00b7\uc7a0\uc7ac \ud76c\uc11d\uc744 \uc815\uc2dd \ubaa8\ub378\ub9c1\ud558\uc9c0 \uc54a\uace0 \ubc29\ud5a5\uc131 \ucf5c\uc744 \ub9cc\ub4e4\uae30\uc5d0\ub294 \uc801\ud569\ud558\uc9c0 \uc54a\ub2e4.\n\nPharmosa\uc758 \uacf5\uc2dd \ubc1c\ud45c\uc5d0 \ub530\ub974\uba74 2023\ub144 \ubd81\ubbf8 \ub77c\uc774\uc120\uc2a4\ub294 \uc120\uae09\uae08 US$10.0m, \uc870\uac74\ubd80 \uac1c\ubc1c\u00b7\ud310\ub9e4 \ub9c8\uc77c\uc2a4\ud1a4 \ucd5c\ub300 US$215.0m \ubc0f \ubd81\ubbf8 \uc21c\ub9e4\ucd9c\uc758 low-double-digit \ub85c\uc5f4\ud2f0 \uad6c\uc870\uc774\uba70, Liquidia\uac00 \ud6c4\uc18d \uc784\uc0c1\uac1c\ubc1c\u00b7\uc0c1\uc5c5\ud654\ub97c \uc790\ube44\ub85c \ub2f4\ub2f9\ud55c\ub2e4. 2024\ub144 \uc9c0\uc5ed \ud655\ub300 \uacc4\uc57d\uc740 \uc120\uae09\uae08 US$3.5m, \ubd81\ubbf8 \uc678 \uac1c\ubc1c\u00b7\ud310\ub9e4 \ub9c8\uc77c\uc2a4\ud1a4 \ucd5c\ub300 US$157.75m \ubc0f \uae00\ub85c\ubc8c \uc21c\ub9e4\ucd9c\uc758 \ub450 \ub2e8\uacc4 low-double-digit \ub85c\uc5f4\ud2f0 \uad6c\uc870\uc774\uace0, Liquidia\uac00 \ud655\uc7a5\uc9c0\uc5ed \uac1c\ubc1c\u00b7\uaddc\uc81c\u00b7\uc0c1\uc5c5\ud654\ub97c \ub2f4\ub2f9\ud55c\ub2e4. \uc774 \uacc4\uc57d\uc740 L606 \uc9c4\ud589\uacfc Pharmosa\uc758 \uc7a0\uc7ac \uacbd\uc81c\uc131 \uc0ac\uc774\uc758 \uc5f0\uacb0\uc744 \ub4b7\ubc1b\uce68\ud558\uc9c0\ub9cc, `up to` \uc0c1\ud55c\uc740 \uc9c0\uae09\uc870\uac74\u00b7\uc131\uacf5\ud655\ub960\u00b7\uc2dc\uc810\u00b7\uc794\uc5ec\uc561\uc774 \ubc18\uc601\ub41c \uae30\ub300\uac00\uce58\uac00 \uc544\ub2c8\ub2e4. \ub530\ub77c\uc11c \uacc4\uc57d \uc0c1\ud55c\uc744 \ubaa9\ud45c\uac00\ub098 \uae30\uc5c5\uac00\uce58\ub85c \uc0ac\uc6a9\ud558\uc9c0 \uc54a\uc558\ub2e4.\n\n\ucd9c\ucc98: `6875.TW/_spec_2026-Q2_review.md`; `jem_data/tw_census/phalanx_ready.json#6875`; `jem_data/preview/ecal_tw.json`; TPEx `mopsfin_t187ap06_O_ci`; MOPS `ajax_t05st10_ifrs` 2025\ub144 4~6\uc6d4\u00b72026\ub144 1~6\uc6d4; MOPS `ajax_t05st01` 2026-05-05 Q1 \ubc0f 2026-08-04 H1 \uc774\uc0ac\ud68c \ud1b5\uacfc \uacf5\uc2dc; TPEx 2026\ub144 5~8\uc6d4 \uc77c\ubcc4\uc2dc\uc138; https://clinicaltrials.gov/study/NCT07285655; https://www.pharmosa.com.tw/news/f30783; https://www.pharmosa.com.tw/news/2d49ff.\n\n\ud55c\uacc4: \ucee8\uc13c\uc11c\uc2a4\u00b7\ud68c\uc0ac \uc815\ub7c9 \uac00\uc774\ub358\uc2a4\u00b7\uc704\ud5d8\uc870\uc815 \ud30c\uc774\ud504\ub77c\uc778 \uac00\uce58\ub294 \ubbf8\ud655\ubcf4\ub2e4. \uacf5\uc2dd \ub77c\uc774\uc120\uc2a4 \uacc4\uc57d\uc758 \uc870\uac74\ubd80 \uc0c1\ud55c\uc740 \uae30\ub300\uac00\uce58\uac00 \uc544\ub2c8\uba70, \uc9c0\uae09\uc870\uac74\u00b7\uc131\uacf5\ud655\ub960\u00b7\uc2dc\uc810\u00b7\uc794\uc5ec\uc561\uc744 \ubaa8\ub378\ub9c1\ud558\uc9c0 \uc54a\uc558\ub2e4. \uacf5\uc2dd \uc7ac\ubb34\uc81c\ud45c\uc5d0 \ud604\uae08\u00b7\ud604\uae08\ud750\ub984 \uc218\uce58\uac00 \uc788\ub354\ub77c\ub3c4 \uc774 \ubb38\uc11c\uc5d0\uc11c \uc815\uc2dd \ud604\uae08\ub7f0\uc6e8\uc774\u00b7\ud544\uc694\uc790\uae08 \uacbd\ub85c\u00b7\uc7a0\uc7ac \ud76c\uc11d \ubaa8\ub378\uc744 \uc791\uc131\ud558\uc9c0 \uc54a\uc558\ub2e4. Q2 \ub2e8\ub3c5 \uc190\uc775\uc740 \uac19\uc740 MOPS \uc591\uc2dd\uc758 H1 \ub204\uc801\uc5d0\uc11c Q1 \ub204\uc801\uc744 \ucc28\uac10\ud55c \ud30c\uc0dd\uce58\ub2e4. \uc6d4\ub9e4\ucd9c\uacfc \uc7ac\ubb34\uc81c\ud45c \ub9e4\ucd9c\uc740 \uc5f0\uacb0\ubc94\uc704\u00b7\uc870\uc815\u00b7\uc778\uc2dd\uc2dc\uc810 \ucc28\uc774\ub85c \uc77c\uce58\ud558\uc9c0 \uc54a\uc744 \uc218 \uc788\ub2e4.\n\n## QR review_meta\n\n```json\n{\n  \"reviewed_on\": \"2026-08-31\",\n  \"model\": \"gpt-5.6-sol/ultra\",\n  \"verdi