00 \uc6d0\uc7a5 \uc0dd\uc131\uc77c\uc740 \ucd5c\uc2e0\uc774\uc9c0\ub9cc \uc218\ub85d \uc2dc\uacc4\uc5f4\uc740 6\uc6d4\uc5d0\uc11c \uba48\ucdc4\ub2e4. 2026-07\ubd84(1,756\u767e\u4e07\u5186, 103.5%)\uc740 2026-08-17 TDnet \uacf5\uc2dc PDF\ub85c \uc6f9 \ubcf4\uac15\ud588\uace0, 2026-08\ubd84\uc740 \uc544\uc9c1 \ubbf8\uacf5\ud45c(\uc804\ub840\uc0c1 9\uc6d4 \uc911\uc21c \ubc1c\ud45c)\ub2e4.","\uc560\ub110\ub9ac\uc2a4\ud2b8 \ucee8\uc13c\uc11c\uc2a4\ub97c \ud655\ubcf4\ud558\uc9c0 \ubabb\ud588\ub2e4 \u2014 minkabu 2305 \ud398\uc774\uc9c0\uac00 \u300c\u30a2\u30ca\u30ea\u30b9\u30c8\u300d\ub97c '\u5bfe\u8c61\u5916'\ub85c \ud45c\uae30(\ucee4\ubc84\ub9ac\uc9c0 \uc5c6\uc74c)\ud558\uace0 kabutan\uc5d0\ub3c4 \ucee8\uc13c\uc11c\uc2a4 \uc5f4\uc774 \uc5c6\ub2e4. \ub530\ub77c\uc11c consensus.value\u00b7gap_pct\ub294 null\uc774\uba70, \ud68c\uc0ac \ud1b5\uae30 \uac00\uc774\ub358\uc2a4\ub098 \u307f\u3093\u304b\u3076 \ubaa9\ud45c\uc8fc\uac00 1,632\uc5d4\uc744 \ucee8\uc13c\uc11c\uc2a4\ub85c \ub300\uccb4\ud558\uc9c0 \uc54a\uc558\ub2e4.","\uc6d4\ucc28 \ub9e4\ucd9c\uc740 \u76f4\u55b6 395\uc810 + FC 9\uc810 \ub85c\uc5f4\ud2f0\u00b7\ube44\ud488\uacf5\uae09 \ud569\uacc4\uc758 \u500b\u5225\u00b7\u64ae\u5f71\u57fa\u6e96\u00b7\u672a\u76e3\u67fb \uc218\uce58\ub77c \u9023\u7d50 \ub9e4\ucd9c\uacfc \uc815\uc758\uac00 \ub2e4\ub974\ub2e4 \u2014 \uacf5\uc2dc \ub204\uacc4\ud45c\uc0c1 2026-03~05 \u500b\u5225 \ub204\uacc4 7,227\u767e\u4e07\u5186 vs \u9023\u7d50 1Q \u58f2\u4e0a\u9ad8 7,546\u767e\u4e07\u5186\uc73c\ub85c \ubd88\uc77c\uce58\ud558\ubbc0\ub85c, \uc6d4\ucc28\ub97c \uc2e4\uc801 \ub300\uc6a9\uc73c\ub85c \ud658\uc0b0\ud558\uc9c0 \uc54a\uace0 \ubc29\ud5a5\uc131 \uc9c0\ud45c\ub85c\ub9cc \uc37c\ub2e4.","\ub85c\uceec \uc6d0\uc7a5\uc758 2026-06 YoY(+19.7%)\uc640 \ud68c\uc0ac \uacf5\uc2dc \ud45c\uae30(119.6%)\uc5d0 0.1%p \ucc28\uc774\uac00 \uc788\ub2e4 \u2014 \ubc18\uc62c\ub9bc \ucc28\uc774\ub85c \ubcf4\uc774\uba70, \ubcf8\ubb38\uc5d0\ub294 \uc591\ucabd\uc744 \ubcd1\uae30\ud588\ub2e4.","\ud68c\uc0ac\uac00 2Q \ub204\uacc4(\uc0c1\ubc18\uae30) \uc2e4\uc801\uc608\uc0c1\uc744 \ubbf8\uacf5\ud45c\ud574(\ud558\ubc18\uae30 \uc2dc\uce58\uace0\uc0b0 \ud3b8\uc911) 1Q \uc2e4\uc801\uc744 \uac00\uc774\ub358\uc2a4\uc640 \uc815\ud569\uc801\uc73c\ub85c \ube44\uad50\ud560 \uc218 \uc5c6\ub2e4 \u2014 \ud1b5\uae30 \ub300\ube44 \uc9c4\ucc99\ub960\uc740 \uacc4\uc808\uc131 \ub54c\ubb38\uc5d0 \ud574\uc11d\ub825\uc774 \ub0ae\ub2e4.","\uc774 \ubb38\uc11c\ub294 \ubc1c\ud45c(2026-07-13) \ud6c4 \uc57d 40\uc77c \uc2dc\uc810\uc758 \uc0ac\ud6c4 \ub9ac\ubdf0\ub85c, \uc5d4\uc9c4\uc758 review \uc708\ub3c4(T+0~T+2)\ub97c \ud06c\uac8c \ubc97\uc5b4\ub09c\ub2e4.","TDnet \uc6d0\ubcf8 \uc11c\ubc84(release.tdnet.info) \ubc0f yanoshin \ub9ac\ub2e4\uc774\ub809\ud2b8\ub294 \uac8c\uc2dc 30\uc77c \uacbd\uacfc\ub85c 404\ub97c \ubc18\ud658\ud574, \u77ed\u4fe1 PDF \ubcf8\ubb38\uc740 IRBANK \ubbf8\ub7ec(f.irbank.net)\uc5d0\uc11c \ucde8\ub4dd\ud588\ub2e4. \ud30c\uc77c\uba85 doc id\ub294 TDnet \uacf5\uc2dc\ubaa9\ub85d\uc758 \uac83\uacfc \ub3d9\uc77c\ud558\ub2e4.","\uc5c5\u00b7\ub2e4\uc6b4\uc0ac\uc774\ub4dc \ubc30\uc218\ub294 \uc560\ub110\ub9ac\uc2a4\ud2b8 \ubaa9\ud45c PER\uc774 \uc544\ub2c8\ub77c \ucd5c\uadfc 6\uac1c\uc6d4 \uc2e4\uac70\ub798 \ubc34\ub4dc\ub97c \ud68c\uc0ac \uac00\uc774\ub358\uc2a4 EPS\ub85c \ub098\ub208 \uac12\uc774\ub2e4 \u2014 \uc2e4\uc81c 52\uc8fc \uace0\uac00 2,154\uc5d4\ubcf4\ub2e4 \ub0ae\uc740 2,025\uc5d4\uc744 \uc0c1\ub2e8\uc73c\ub85c \uc368 \ud3ed\uc774 \ubcf4\uc218\uc801\uc774\uba70, \uc5ed\uc0ac\uc801 \ubaa9\ud45c\ubc30\uc218 \ubd84\uc11d\uc744 \ub300\uccb4\ud558\uc9c0 \ubabb\ud55c\ub2e4.","2026\u5e742\u6708\u671f \u77ed\u4fe1 \uba38\ub9ac\ud45c\ub294 \uc21c\uc774\uc775 1,162\u767e\u4e07\u5186\uc758 YoY\ub97c \u25b315.6%\ub85c \ud45c\uae30\ud558\uc9c0\ub9cc \uc804\ub144 1,365\u767e\u4e07\u5186 \ubc0f \uc815\ud655\uc561 1,162,055/1,365,115\u5343\u5186\uc73c\ub85c \uc7ac\uacc4\uc0b0\ud558\uba74 \u25b314.9%\uc774\uace0, \uac19\uc740 PDF p.2 \uacbd\uc601\uc131\uc801 \uc124\uba85\ub3c4 \u25b314.9%\ub