c815\ud588\uc73c\uba70, \uacf5\uc2dd IR \uce98\ub9b0\ub354 \ud398\uc774\uc9c0\ub294 \ubcc4\ub3c4 \ub300\uc870\ud558\uc9c0 \uc54a\uc558\ub2e4.","'2026-Q2'\ub294 \uce98\ub9b0\ub354 \ub77c\ubca8\uc774\ub2e4. \uc2e4\uc81c \uc778\uc6a9 \uc2e4\uc801\uc740 3\uc6d4 \uacb0\uc0b0\uc0ac\uc778 \ub3d9\uc0ac\uc758 FY2027\u5e743\u6708\u671f \u7b2c1\u56db\u534a\u671f(2026/4/1~6/30)\uc774\uba70, \ud68c\uc0ac\uac00 \uc790\uce6d\ud558\ub294 '2Q(\u4e2d\u9593\u671f)'\uc640\ub294 \ub2e4\ub978 \uae30\uac04\uc774\ub2e4. \ub77c\ubca8 \ud63c\ub3d9\uc5d0 \uc8fc\uc758.","\ubd84\uae30 \ub2e8\uc704 \uc560\ub110\ub9ac\uc2a4\ud2b8 \ucee8\uc13c\uc11c\uc2a4\ub294 \uc874\uc7ac\ud558\uc9c0 \uc54a\ub294\ub2e4. minkabu\ub294 \ud1b5\uae30(FY2027/3) \ub9e4\ucd9c\u00b7\uc21c\uc774\uc775\u00b7EPS \ucee8\uc13c\ub9cc \uac8c\uc7ac\ud558\uace0 \uc601\uc5c5\uc775\u00b7\uacbd\uc0c1\uc775 \ucee8\uc13c\uc740 '---'\ub85c \ube44\uc5b4 \uc788\ub2e4. \ub530\ub77c\uc11c consensus.gap_pct\ub294 '\uc774\ubc88 \ubd84\uae30 \uc2e4\uc801\uc758 \ucee8\uc13c \uc11c\ud504\ub77c\uc774\uc988 \ud3ed'\uc774 \uc544\ub2c8\ub77c '\ud1b5\uae30 \uc21c\uc774\uc775 \ucee8\uc13c vs \ud68c\uc0ac \uac00\uc774\ub358\uc2a4'\uc758 \ucc28\uc774\uc77c \ubfd0\uc774\uba70, \ub450 \uac1c\ub150\uc744 \ud63c\ub3d9\ud574\uc11c\ub294 \uc548 \ub41c\ub2e4.","kabutan \ubb34\ub8cc \ud398\uc774\uc9c0\uc5d0\ub294 \uc560\ub110\ub9ac\uc2a4\ud2b8 \ucee8\uc13c \uc5f4\uc774 \uc5c6\uc5b4(\u682a\u63a2\u30d7\u30ec\u30df\u30a2\u30e0 \uc720\ub8cc \uc601\uc5ed) \ucee8\uc13c\uc744 minkabu \ub2e8\uc77c \uc18c\uc2a4\uc5d0 \uc758\uc874\ud588\ub2e4. \ucee4\ubc84 \uc560\ub110\ub9ac\uc2a4\ud2b8\uac00 4\uc778\uc5d0 \ubd88\uacfc\ud574 \ud3c9\uade0 \ubaa9\ud45c\uc8fc\uac00 4,470\uc5d4\uc740 \uc18c\uc218 \uc758\uacac\uc5d0 \ubbfc\uac10\ud558\ub2e4 \u2014 3\uac1c\uc6d4 \uc804 3,190\uc5d4\uc5d0\uc11c 1\uac1c\uc6d4 \uc0c8 +40% \uae09\ub4f1\ud55c \uc774\ub825\uc774 \uadf8 \ubcc0\ub3d9\uc131\uc744 \ubcf4\uc5ec\uc900\ub2e4.","upside\uc758 base_pct/downside_pct\uc5d0 \uc4f4 PER 17\ubc30\u00b712.5\ubc30\ub294 \ucd5c\uadfc 6\uac1c\uc6d4~52\uc8fc \uad00\uce21 \uc8fc\uac00\ub97c \ucee8\uc13c EPS\ub85c \ub098\ub208 \ubc34\ub4dc\uc5d0\uc11c \ucde8\ud55c \uac00\uc815\uce58\uc774\uc9c0 \ud68c\uc0ac\u00b7\uc560\ub110\ub9ac\uc2a4\ud2b8\uac00 \uc81c\uc2dc\ud55c \uc218\uce58\uac00 \uc544\ub2c8\ub2e4. \ud655\uc815\uce58\ub85c \uc77d\uc73c\uba74 \uc548 \ub41c\ub2e4.","priced_in.pct_est 65\ub294 \uc815\ub7c9 \ubaa8\ub378\uc774 \uc544\ub2c8\ub77c '\ubc1c\ud45c \ud6c4 -4.8% \ud558\ub77d + \ubc1c\ud45c \uc804 3\uc6d4 \ub9d0~6\uc6d4 \ub9d0 +60.3% \uc0c1\uc2b9'\uc774\ub77c\ub294 \uad00\uce21 \uc0ac\uc2e4\uc5d0 \uae30\ubc18\ud55c \uc11c\uc220\uc801 \ucd94\uc815\uce58\ub2e4.","QR\uc5d0\uc11c \u77ed\u4fe1 \ucca8\ubd80 P.6 \uc190\uc775\uacc4\uc0b0\uc11c\uae4c\uc9c0 \uc7ac\uc2e4\uce21\ud574 \uacbd\uc0c1\uc775 \uc99d\uac00\ubd84\uc744 \ubd84\ud574\ud588\ub2e4. \uacbd\uc0c1\uc775 \uc99d\uac00 8,622\ubc31\ub9cc\uc5d4 \uc911 \uc601\uc5c5\uc775 \uc99d\uac00\uac00 3,309, \uc21c\uc601\uc5c5\uc678\uc190\uc775 \uac1c\uc120\uc774 5,313\uc774\uba70, \ud658\ucc28\uc190 1,473\u2192\ud658\ucc28\uc775 2,998\uc758 \uc2a4\uc719 4,471\uc774 \uc804\uccb4 \uc99d\uac00\uc758 51.9%\ub97c \ucc28\uc9c0\ud55c\ub2e4. \uc218\ucde8\ubc30\ub2f9\uae08\ub3c4 1,529\u21922,494\ub85c \ub298\uc5c8\ub2e4. \ub2e4\ub9cc \ud658\ucc28\uc775\uc758 \ud1b5\ud654\ubcc4 \uc6d0\ucc9c\u00b7\ud5e4\uc9c0 \uc5ec\ubd80\uc640 \ud5a5\ud6c4 \uc7ac\ud604\uc131\uc740 \uacf5\uc2dc\ub418\uc9c0 \uc54a\uc544 \uacbd\uc0c1\uc775\uc758 \uc9c8\uc5d0\ub294 \uc5ec\uc804\ud788 \ubd88\ud655\uc2e4\uc131\uc774 \uc788\ub2e4.","\u61f8\u67b6\u3070\u306d \uc601\uc5c5\uc801\uc790\uc758 \uc6d0\uc778\uc73c\ub85c \u77ed\u4fe1\uc774 \ub4e0 '\ubbf8\uad6d \uad00\uc138 \uc601\ud5a5'\uacfc '\uc77c\uacfc\uc131 \ube44\uc6a9'\uc758 \uac01 \uae08\uc561\uc740 \uacf5\uc2dc\uc5d0 \ubd84\ub9ac \ud45c\uae30\ub418\uc9c0 \uc54a\uc544 \uc815\ub7c9\ud654\ud558\uc9c0 \ubabb\ud588\ub2e4. \ub530\ub77c\uc11c \uc774 \uc801\uc790\uac00 \uad6c\uc870\uc801\uc778\uc9c0 \uc77c\ud68c\uc131\uc778\uc9c0 \ud310\ub2e8 \uadfc\uac70\uac00 \ubd80\uc871\ud558\ub2e4.","\ub85c\uceec PPI 5\uacc4\uc5f4\uc740 \ud310\uac00/\uc6d0\uac00\uc758 \ub300\ub9ac\ubcc0\uc218\uc77c \ubfd0 \ub3d9\uc0ac\uc758 \uc2e4\uc81c \ud310\ub9e4\ub2e8\uac00\u00b7\uc870\ub2ec\ub2e8\uac00\uac00 \uc544\ub2c8\ub2e4. \ud2b9\ud788 DDS\ub294 HDD \uc11c\uc2a4\ud39c\uc158 \ub2e8\ud488\uc73c\ub85c, \u7f8e \uc2a4\ud1a0\ub9ac\uc9c0 \uc644\uc81c\ud488 PPI(+31.5%)\uac00 \ub3d9\uc0ac \uc11c\uc2a4\ud39c\uc158 \ud310\uac00\uc5d0 \uadf8\ub300\ub85c \uc804\uc774\ub41c\ub2e4\ub294 \uadfc\uac70\ub294 \uc5c6\ub2e4. \uc0c1\uad00 \ubc29\ud5a5\ub9cc \ucc38\uace0\ud588\ub2e4.","\u7f8e \uc81c\ucca0 PPI\ub294 2026-07\uae4c\uc9c0 \uc788\uc73c\ub098 \u7f8e \uc2a4\ud1a0\ub9ac\uc9c0 PPI\ub294 2026-06\uae4c\uc9c0\ub9cc \uacf5\ud45c\ub418\uc5b4 \uacc4\uc5f4 \uac04 \ucd5c\uc2e0\uc6d4\uc774 \ubd88\uc77c\uce58\ud55c\ub2e4. \ub610 \uc77c\ubd80 \uc6d4(2025-11/12, 2026-02/03, 2026-04/05)\uc740 \uac12\uc774 \ub3d9\uc77c\ud574 \ubcf4\uac04\u00b7\ubbf8\uac31\uc2e0 \uac00\ub2a5\uc131\uc774 \uc788\uc5b4 \uc6d4\ubcc4 \ubbf8\uc138 \ubcc0\ud654 \ud574\uc11d\uc740 \uc0bc\uac14\ub2e4.","\ud310\uc815 '\uc911\ub9bd'\uc740 minkabu \uc560\ub110\ub9ac\uc2a4\ud2b8 \uc885\ud569\uc758\uacac '\u8cb7\u3044'(\uac15\uae30\ub9e4\uc218 2\u00b7\ub9e4\uc218 1\u00b7\uc911\ub9bd 1)\uc640 \uc0c1\ubc18\ub41c\ub2e4. \uc601\uc5c5\uc775 \ubc18\uc804\uc740 \ubd84\uba85\ud558\uc9c0\ub9cc \uacbd\uc0c1\uc775 \uc99d\uac00\ubd84\uc758 51.9%\uac00 \ud658\uc728 \uc2a4\uc719\uc774\uace0, \ud68c\uc0ac\uac00 \uac00\uc774\ub358\uc2a4\ub97c \uc62c\ub9ac\uc9c0 \uc54a\uc558\uc73c\uba70 \ubc1c\ud45c \ud6c4 \uc8fc\uac00\uac00 \ud558\ub77d\ud588\ub2e4\ub294 \uad00\uce21 \uc0ac\uc2e4\uc744 \ub354 \ubb34\uac81\uac8c \ubcf8 \uacb0\uacfc\ub77c \ud310\ub2e8\uc758 \uc5ec\uc9c0\ub294 \ub0a8\ub294\ub2e4.","\ubcf8 \ubb38\uc11c\ub294 \ud22c\uc790\ud310\ub2e8 \ucc38\uace0\uc6a9\uc774\uba70 \ud22c\uc790 \uad8c\uc720\uac00 \uc544\ub2d9\ub2c8\ub2e4."],"review_meta":{"reviewed_o