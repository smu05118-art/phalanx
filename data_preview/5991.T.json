 3,479\uc5d4 \ub300\ube44 +28.48%)\uc774\uba70 3\uac1c\uc6d4 \uc804 3,190\uc5d4 \u2192 1\uac1c\uc6d4 \uc804 4,470\uc5d4\uc73c\ub85c \uc0c1\ud5a5\ub41c \ub4a4 \uc720\uc9c0. \ub2e8 \uc601\uc5c5\uc775\u00b7\uacbd\uc0c1\uc775\uc758 \uc560\ub110\ub9ac\uc2a4\ud2b8 \ucee8\uc13c\uc740 minkabu\uc5d0 \uac8c\uc7ac\ub418\uc9c0 \uc54a\uc544('---') \ubd84\uae30 \ub2e8\uc704 \ucee8\uc13c \uac2d\uc740 \uc0b0\ucd9c \ubd88\uac00 \u2014 \ubcf8 gap_pct\ub294 \ubd84\uae30 \uc2e4\uc801 \uc11c\ud504\ub77c\uc774\uc988 \ud3ed\uc774 \uc544\ub2c8\ub77c \ud1b5\uae30 \ucee8\uc13c vs \ud68c\uc0ac \uac00\uc774\ub358\uc2a4\uc758 \ucc28\uc774\ub2e4."},"priced_in":{"summary":"\ub300\uccb4\ub85c \uc120\ubc18\uc601. \uc815\ud655\ud55c \ub2ec\ub825 \uc6d4\ub9d0 \uc885\uac00 \uae30\uc900 2026-03-31 2,424\uc5d4 \u2192 06-30 3,885\uc5d4(+60.3%) \uad6c\uac04\uc5d0\uc11c \uc2a4\ud1a0\ub9ac\uc9c0 \uc0ac\uc774\ud074\uacfc DDS \ud638\uc870\ub97c \uc774\ubbf8 \uac00\uaca9\uc5d0 \ub123\uc5c8\uace0, 8\uc6d4 6\uc77c \ubc1c\ud45c\ub294 \ucd94\uac00 \uc7ac\ud3c9\uac00\ub85c \uc774\uc5b4\uc9c0\uc9c0 \ubabb\ud588\ub2e4. \ub370\uc774\ud130 5\uacc4\uc5f4\uc740 \ubaa8\ub450 up\uc774\uc9c0\ub9cc \uadf8\uc911 2\uacc4\uc5f4\uc774 COST(\uc6d0\uac00 \ubd80\ub2f4)\ub77c \ubc29\ud5a5\uc774 \uc21c\uc218\ud55c \ud638\uc7ac\uac00 \uc544\ub2c8\uba70, \uacbd\uc0c1\uc775 \uc99d\uac00\ubd84\uc758 51.9%\uac00 \ud658\ucc28\uc190\u2192\ud658\ucc28\uc775 \uc804\ud658\uc774\ub77c\ub294 \uc810\ub3c4 \uc11c\ud504\ub77c\uc774\uc988\uc758 \uc9c8\uc744 \ub0ae\ucd98\ub2e4.","evidence":["\ucd5c\uadfc 3M \uc8fc\uac00 +7.24%, \ucd5c\uadfc 1M -4.48% (2026-08-21 \uc885\uac00 3,479\uc5d4, Yahoo Finance chart API \uc9c1\uc811 \uc7ac\uc870\ud68c). \ub2ec\ub825 \uc6d4\ub9d0(\uc6d4 \ub9c8\uc9c0\ub9c9 \uac70\ub798\uc77c) \uc885\uac00 \ucd94\uc774 2026-03-31 2,424 \u2192 04-30 2,868 \u2192 05-29 3,589 \u2192 06-30 3,885 \u2192 07-31 3,610 \u2192 08-21 3,479 \u2014 3\uc6d4 \ub9d0~6\uc6d4 \ub9d0 +60.3%\ub85c \uc0c1\uc2b9\ubd84\uc758 \ub300\ubd80\ubd84\uc774 \ubc1c\ud45c \uc774\uc804\uc5d0 \ubc1c\uc0dd. \uae30\uc874 2,656/2,785.5/3,925/3,328\uc740 21\uac70\ub798\uc77c \uac04\uaca9 \ud45c\ubcf8(3/26\u00b74/24\u00b76/29\u00b77/29)\uc744 \uc6d4\ub9d0\ub85c \uc798\ubabb \ubd80\ub978 \uac12\uc774\uc5b4\uc11c \uad50\uc815","\ubc1c\ud45c \ub2f9\uc77c(2026-08-06 15:30, \uc7a5 \ub9c8\uac10 \ud6c4) \uc885\uac00 3,654\uc5d4 \u2192 \uc775\uc77c 3,553\uc5d4(-2.8%), 8/17 3,753\uc5d4\uae4c\uc9c0 \ubc18\ub4f1\ud588\ub2e4\uac00 8/21 3,479\uc5d4\uc73c\ub85c \ubc1c\ud45c\uc77c \ub300\ube44 -4.8%. \uacbd\uc0c1\uc775 +71.7% \uc11c\ud504\ub77c\uc774\uc988\uac00 \uc8fc\uac00 \uc7ac\ud3c9\uac00\ub85c \uc774\uc5b4\uc9c0\uc9c0 \uc54a\uc740 \uc804\ud615\uc801 sell-on-news (Yahoo Finance \uc77c\ubd09 \uc2e4\uce21)","\ubcf4\uc720\ub370\uc774\ud130 \ubc29\ud5a5 \u2014 BENEF 3\uacc4\uc5f4(\u7f8e \uc2a4\ud1a0\ub9ac\uc9c0 +31.46%, \u7f8e \uc790\ub3d9\ucc28\ubd80\ud488 +2.44%, \u65e5 \uc790\ub3d9\ucc28\ubd80\ud488 +2.99%)\uc740 \ubaa8\ub450 up\uc73c\ub85c \ud310\uac00\ub294 \uc6b0\ud638\uc801\uc774\ub098, COST 2\uacc4\uc5f4(\u7f8e \uc81c\ucca0 +24.60%, \u65e5 CGPI \ucca0\uac15 +1.67%\ub85c \ub9c8\uc774\ub108\uc2a4\u2192\ud50c\ub7ec\uc2a4 \uc804\ud658)\ub3c4 \ub3d9\uc2dc\uc5d0 up\uc774\ub77c \u61f8\u67b6\u3070\u306d \uc6d0\uac00 \ubd80\ub2f4\uc774 \ucee4\uc9c0\ub294 \uc0c1\ucda9 \uad6c\ub3c4","2025-08-22~2026-08-21 \ub2ec\ub825 52\uc8fc \uc885\uac00 \ubc34\ub4dc 1,856~4,243\uc5d4: \uace0\uc810 \ub300\ube44 -18.0%, \uc800\uc810 \ub300\ube44 +87.4%. \uae30\uc874 \uc800\uc810 2,424\uc5d4\uc740 6\uac1c\uc6d4 \uad6c\uac04 \uc800\uc810\uc744 52\uc8fc \uc800\uc810\uc73c\ub85c \uc624\uc778\ud55c \uac12\uc774\uc5b4\uc11c \uad50\uc815. PER 15.7\ubc30\u00b7PBR 1.55\ubc30(kabutan/irbank 2026-08-21 \uc2e4\uce21)\ub85c irbank \uae30\uc900 2010\ub144 \uc774\ud6c4 PBR \ubc34\ub4dc 0.46~1.77\ubc30\uc758 \uc0c1\ub2e8\uad8c"],"pct_est":65},"upside":{"base_pct":12.5,"downside_pct":-17.3,"valuation_basis":"\ud604\uc7ac\uac00 3,479\uc5d4(2026-08-21) \u00b7 PER 15.7\ubc30 \u00b7 PBR 1.55\ubc30 \u00b7 \uc2dc\ucd1d 8,039\uc5b5\uc5d4(kabutan/irbank \uc2e4\uce21). \ubc38\ub958\uc5d0\uc774\uc158 \uc575\ucee4\ub294 minkabu \uc560\ub110\ub9ac\uc2a4\ud2b8 \ucee8\uc13c FY2027/3 EPS 230.14\uc5d4(\ud604\uc7ac\uac00 \uae30\uc900 PER 15.1\ubc30). \uad00\uce21\uc810\uc740 \ub2ec\ub825 52\uc8fc \uace0\uc810 4,243\uc5d4 = 18.4\ubc30, 2026-03-31 \uc885\uac00 2,424\uc5d4 = 10.5\ubc30\ub2e4. Base = \ucee8\uc13c EPS 230.14 \u00d7 PER 17\ubc30 \u2192 3,912\uc5d4(+12.5%) \u2014 DDS \uc138\uadf8\uba3c\ud2b8 \uc601\uc5c5\uc775 \uc608\uc0c1 \uc0c1\ud5a5(30,000\u219231,000)\uacfc \uc601\uc5c5\uc775 +30.0%\ub97c \uadfc\uac70\ub85c \uace0\uc810 \ubc30\uc218\ubcf4\ub2e4 \ub0ae\uac8c \uac00\uc815. \uacbd\uc0c1\uc775 \uc9c4\ucc99\ub960 32.3%\ub294 \uc99d\uac00\ubd84\uc758 51.9%\uac00 \ud658\ucc28\uc190\u2192\ud658\ucc28\uc775 \uc804\ud658\uc774\ub77c \ubc30\uc218 \uc0c1\ud5a5\uc758 \ub3c5\ub9bd \uadfc\uac70\ub85c \uc4f0\uc9c0 \uc54a\ub294\ub2e4. Downside = \ucee8\uc13c EPS 230.14 \u00d7 PER 12.5\ubc30 \u2192 2,877\uc5d4(-17.3%) \u2014 \uc2a4\ud1a0\ub9ac\uc9c0 \uc0ac\uc774\ud074 \ub454\ud654 + \ucca0\uac15 \uc6d0\uac00 \uc0c1\uc2b9\uc73c\ub85c \u61f8\u67b6\u3070\u306d \uc801\uc790\uac00 \uc9c0\uc18d\ub420 \uacbd\uc6b0\uc774\uba70, \uc2e4\uc81c 3/31 \uc800\uc810 \ubc30\uc218 10.5\ubc30\ubcf4\ub2e4\ub294 \uc644\ud654\ub41c \uac00\uc815\uc774\ub2e4. \ucc38\uace0\ub85c \uc560\ub110\ub9ac\uc2a4\ud2b8 \ud3c9\uade0 \ubaa9\ud45c\uc8fc\uac00 4,470\uc5d4(+28.5%)\uc740 \ubcf8 base\ubcf4\ub2e4 \uacf5\uaca9\uc801\uc774\ub2e4. \uc801\uc6a9 \uba40\ud2f0\ud50c 17\ubc30/12.5\ubc30\ub294 \uad00\uce21 \ubc94\uc704\uc5d0\uc11c \ucde8\ud55c \uac00\uc815\uce58\uc774\uba70 \ud655\uc815\uce58\uac00 \uc544\ub2c8\ub2e4."},"sources":["yanoshin TDnet API \uacf5\uc2dc\ubaa9\ub85d \u2014 https://webapi.yanoshin.jp/webapi/tdnet/list/5991.json?limit=40 (\ubc1c\ud45c\uc77c 2026-08-06 15:30:00 \ud655\uc815)","2027\u5e74\uff13\u6708\u671f \u7b2c\uff11\u56db\u534a\u671f\u6c7a\u7b97\u77ed\u4fe1\u3014\u65e5