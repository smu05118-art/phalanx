35\uc6d0\uc73c\ub85c **+15.7%**. downside\ub294 \ucd5c\uadfc 3\uac1c\uc6d4 \uc800\uc810 148,000\uc6d0\uc73c\ub85c **-26.6%**\ub2e4. 2026-06 BPS 149,377\uc6d0 \uae30\uc900 \uac01\uac01 PBR 1.56\ubc30\uc640 0.99\ubc30\uc774\uba70 \ud604\uc7ac PBR\uc740 \uc57d 1.35\ubc30\ub2e4.\n\n\ud55c\uacc4: 2026-07-07 \uc7a0\uc815\uce58\ub294 2026-07-30 \uacf5\uc2dd \ud655\uc815\uc2e4\uc801\uc73c\ub85c \ub300\uccb4\ud588\ub2e4. \uce74\ub4dc\uc5d0\ub294 \uc21c\uc774\uc775\uc744 \ubcc4\ub3c4 \uc2e4\uce21\ud558\uc9c0 \uc54a\uc558\uace0, \ub85c\uceec \uc7ac\ubb34\ub294 \ubcc4\ub3c4\u00b7\uacf5\uc2dd \uc2e4\uc801\uc740 \uc5f0\uacb0 \uae30\uc900\uc774\ub2e4. \ud655\uc815 \uc601\uc5c5\uc774\uc775\uc5d0\ub294 \uc77c\ud68c\uc131 \uad00\uc138 \ud658\uae09\uc774 \ud3ec\ud568\ub418\uba70 \ubaa9\ud45c\uc8fc\uac00\ub294 \ubbf8\ub798 \uc131\uacfc\ub97c \ubcf4\uc7a5\ud558\uc9c0 \uc54a\ub294\ub2e4.\n\n**\ubcf8 \ubb38\uc11c\ub294 \ud22c\uc790\ud310\ub2e8 \ucc38\uace0\uc6a9\uc774\uba70 \ud22c\uc790 \uad8c\uc720\uac00 \uc544\ub2d9\ub2c8\ub2e4.**\n"}},"archive_diagnostics":[],"tone_reaction":{"schema_version":"tone-reaction-v1","engine_version":"1.3.0","derived":true,"ticker":"066570","name":"LG\uc804\uc790","aliases":[],"as_of":"2026-09-24T11:47:27.599574Z","status":"pending","missing_reasons":["no_events"],"diagnostics":[],"counts":{"stored_files":0,"versioned_documents":0,"legacy_documents_ignored":1,"pending_documents":0,"derived_documents_ignored":0,"duplicate_copies_collapsed":0,"rejected_events":0,"accepted_versions":0,"displayed_events":0,"distinct_event_ids":0,"pool_accepted_versions":37},"events":[],"event_order":[],"series":{"actual_tone":[],"predicted_tone":[],"open_reaction":[],"close_reaction":[]},"interpretation":"Ordinal descriptive comparisons; tone and price grades are different units. No causal inference, equal economic intervals, validated probabilities, or return forecast.","descriptive_current_scale":{"mode":"descriptive_current_scale","method":"company-current-core-midrank-v1","r