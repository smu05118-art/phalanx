 \ucc28\uac10\ud574 \uc0b0\ucd9c\ud588\ub2e4. EPS 7.84\ub294 2026-H1 \ub204\uc801\uce58\uc774\uba70 \ub2e8\ub3c5\ubd84\uae30 EPS\ub85c \uc0ac\uc6a9\ud558\uc9c0 \uc54a\uc558\ub2e4.","\ubc30\ub2f9 \ud3ec\ud568 \ubcf4\uc720\uc218\uc775\ub960\uc740 \ud604\uae08\ubc30\ub2f9\uc744 \uc138\uc804 \uc804\uc561 \uc218\ub839\ud558\uace0 \uc7ac\ud22c\uc790\ud558\uc9c0 \uc54a\uc740 \ub2e8\uc21c \uc218\uc775\ub960\uc774\ub2e4. \uc138\uae08\u00b7\uc218\uc218\ub8cc\u00b7\ubc30\ub2f9 \uc7ac\ud22c\uc790 \ud6a8\uacfc\ub294 \ubc18\uc601\ud558\uc9c0 \uc54a\uc558\ub2e4."],"review_meta":{"reviewed_on":"2026-08-28","model":"gpt-5.6-sol/ultra","verdict":"upgraded","changes":["\ubc1c\ud45c\uc77c\uc744 ecal_tw \ub808\uc9c0\uc2a4\ud2b8\ub9ac \uc77c\ubc18 \uae30\uc900\uc77c 2026-08-14\uc5d0\uc11c MOPS \uc2e4\uc81c \ud68c\uc0ac \uacf5\uc2dc\uc77c 2026-08-27\ub85c \uad50\uccb4\ud558\uace0, \ubcf4\ud5d8\uc5c5\uc758 \ud655\uc815 \ubc95\uc815\uae30\ud55c\uc73c\ub85c \ub2e8\uc815\ud558\uc9c0 \uc54a\uc558\ub2e4.","MOPS 2026-H1\u00b7Q1 \ubc0f 2025-H1\u00b7Q1 \uc6d0\ubb38\uc744 \ub300\uc870\ud574 \ub2e8\ub3c5 2\ubd84\uae30 \uc601\uc5c5\uc218\uc775 4,712,500\ucc9c TWD, \uc601\uc5c5\uc774\uc775 1,470,816\ucc9c TWD, \uc21c\uc774\uc775 1,355,743\ucc9c TWD\ub97c \ubcf5\uc6d0\ud588\ub2e4.","\ud310\uc815 \uadfc\uac70\ub97c \uc6d4\ub9e4\ucd9c \ub2e8\uc77c \uc2e0\ud638\uc5d0\uc11c \uacf5\uc2dd 2\ubd84\uae30 \uc601\uc5c5\uc218\uc775\u00b7\uc601\uc5c5\uc774\uc775\u00b7\uc21c\uc774\uc775\uc758 \uc804\ub144\ub3d9\uae30 \uac1c\uc120\uc73c\ub85c \ubcf4\uac15\ud588\ub2e4.","8\uc6d4 21\uc77c \uc885\uac00 \uc774\ud6c4 8\uc6d4 27\uc77c \uc2e4\uc801 \uacf5\uc2dc\uac00 \ubc1c\uc0dd\ud55c \uc2dc\uc810 \ubd88\uc77c\uce58\ub97c \uc81c\uac70\ud558\uae30 \uc704\ud574 \uac00\uaca9 \uad00\uce21 \uc885\ub8cc\uc77c\uc744 \uacf5\uc2dc \ub2f9\uc77c \uc885\uac00\ub85c \uc5f0\uc7a5\ud588\ub2e4.","TWSE \uc81c\uad8c\uc81c\uc2dd\uc5d0\uc11c \uae30\uac04 \uc911 \ud604\uae08\ubc30\ub2f9 NT$1.50\uc744 \ud655\uc778\ud558\uace0, \uacf5\uc2dc \ub