13)\ub85c \ubcf4\uc644\ud588\ub2e4.","\uc6d4\ucc28 form=idx \ud55c\uacc4: \uc774 \uc2dc\uacc4\uc5f4\uc740 \uc6d4\ucc28 YoY%\ub97c \uae30\uc900=100\uc73c\ub85c \uc9c0\uc218\ud654\ud55c \uac83\uc73c\ub85c \ub808\ubca8\uc758 \uc808\ub300 \uc758\ubbf8\uac00 \uc5c6\ub2e4. 118.43 \uac19\uc740 \uac12\uc744 \ub9e4\ucd9c\uc561\uc774\ub098 \uc808\ub300 \uc218\uc900\uc73c\ub85c \uc77d\uc5b4\uc11c\ub294 \uc548 \ub418\uba70, \ubc29\ud5a5(up/flat/down)\uacfc YoY \ubcc0\ud654\uc728\ub9cc \uc720\ud6a8\ud558\ub2e4. \ubcf8 \ubb38\uc11c\ub294 idx\ub97c \ubc29\ud5a5 \ud310\uc815\uc5d0\ub9cc \uc4f0\uace0, \uae08\uc561\uc740 \uc804\ubd80 \ud68c\uc0ac \uacf5\uc2dc\u00b7\u6c7a\u7b97\u77ed\u4fe1 \uc2e4\uce21\uce58\ub85c \ub300\uccb4\ud588\ub2e4.","\ucee8\uc13c\uc11c\uc2a4 \ubbf8\ud655\ubcf4: minkabu\u00b7kabutan 3\uac1c URL\uc744 \uc2e4\uc81c \uc870\ud68c\ud588\uc73c\ub098(HTTP 200) \uc560\ub110\ub9ac\uc2a4\ud2b8 \uc2e4\uc801 \ucee8\uc13c\uc11c\uc2a4 \ud56d\ubaa9\uc774 \uc874\uc7ac\ud558\uc9c0 \uc54a\uc558\ub2e4. \ub530\ub77c\uc11c consensus.value\u00b7gap_pct\ub294 null\uc774\uba70 \ucee8\uc13c\uac2d \ud310\uc815\uc740 \ubd88\uac00\ub2a5\ud558\ub2e4. \ub300\uc548\uc73c\ub85c \uc4f4 \ud68c\uc0ac \ud1b5\uae30 \uac00\uc774\ub358\uc2a4\ub294 \ucee8\uc13c\uc11c\uc2a4\uac00 \uc544\ub2c8\uace0 \ud68c\uc0ac \uc790\uccb4 \uc804\ub9dd\uc774\ubbc0\ub85c \uc11c\ud504\ub77c\uc774\uc988 \ud310\uc815 \uae30\uc900\uc73c\ub85c\ub294 \uc57d\ud558\ub2e4.","\uc6d4\ucc28 \ub9e4\ucd9c \u2260 \uc190\uc775: \ud655\ubcf4\ud55c 1Q \uc2e4\uce21\uc740 \ub9e4\ucd9c \ub77c\uc778\ubfd0\uc774\ub2e4. \uc601\uc5c5\uc774\uc775\u00b7\uacbd\uc0c1\uc774\uc775\u00b7\uc21c\uc774\uc775\uc740 9/9 \ubc1c\ud45c \uc804\uae4c\uc9c0 \ud655\uc778 \ubd88\uac00\uc774\uba70, \uc6d0\ub8cc\uc721 \uc2dc\uc138\u00b7\uc778\uac74\ube44\u00b7\ub808\uc2a4\ud1a0\ub791 \uc0ac\uc5c5 \ucd95\uc18c(-27.3%)\uc758 \ub9c8\uc9c4 \uc601\ud5a5\uc740 \ubcf8 \ubb38\uc11c\uc5d0\uc11c \uc815\ub7c9\ud654\ud558\uc9c0 \ubabb\ud588\ub2e4.","\uc6d4\ucc28 \uc18d\ubcf4\uce58\ub294 \u672a\u76e3\u67fb\uc774\uba70 \u6c7a\u7b97\u77ed\u4fe1 \uc5f0\uacb0\ub9e4\ucd9c\uacfc \uc815\ud655\ud788 \uc77c\uce58\ud558\uc9c0 \uc54a\ub294\ub2e4 \u2014 \uc804\ub144 1Q \uc6d4\ucc28\ud569\uacc4 8,663\ubc31\ub9cc\uc5d4 vs \u6c7a\u7b97\u77ed\u4fe1 \uc5f0\uacb0\ub9e4\ucd9c 8,657\ubc31\ub9cc\uc5d4(\ucc28\uc774 6\ubc31\ub9cc\uc5d4, 0.07%). \ub530\ub77c\uc11c \uc774\ubc88 1Q \uc5f0\uacb0\ub9e4\ucd9c\ub3c4 8,451\ubc31\ub9cc\uc5d4 \ubd80\uadfc\uc774\ub418 \uc18c\ud3ed \uc5b4\uae0b\ub0a0 \uc218 \uc788\ub2e4.","\ubc1c\ud45c\uc77c 2026-09-09\ub294 ecal_jp \uc6d0\uc7a5(kabuyoho.jp) \uac12\uc774\uba70, \ud68c\uc0ac \uacf5\uc2dd '\uacb0\uc0b0\ubc1c\ud45c \uc608\uc815\uc77c' \uace0\uc9c0\ub97c \uc774 \uc138\uc158\uc5d0\uc11c \uc9c1\uc811 \ud655\uc778\ud558\uc9c0\ub294 \ubabb\ud588\ub2e4. TDnet \uacf5\uc2dc\uc774\ub825\uc758 1Q \u77ed\u4fe1 \ubc1c\ud45c \ud328\ud134(2025-09-08, 2024-09-12)\uc73c\ub85c \uad50\ucc28\ud655\uc778\ud574 \uc815\ud569\uc131\ub9cc \ud655\ubcf4\ud55c \uc0c1\ud0dc\ub2e4.","\ubc38\ub958\uc5d0\uc774\uc158\uc740 \ubc30\uc218 1\uac1c(\uac00\uc774\ub358\uc2a4 EPS \uae30\uc900 PER)\uc640 52\uc8fc \ubc34\ub4dc\uc5d0 \uc758\uc874\ud55c \ub2e8\uc21c \uc0b0\uc2dd\uc774\ub2e4. \ud53c\uc5b4 \uba40\ud2f0\ud50c \ube44\uad50\u00b7DCF\u00b7\uc138\uadf8\uba3c\ud2b8\ubcc4 \uc774\uc775 \ucd94\uc815\uc740 \uc218\ud589\ud558\uc9c0 \uc54a\uc558\uace0, \ubc30\ub2f9\uc131\ud5a5 101.8%(\uc21c\uc774\uc775 800\ubc31\ub9cc\uc5d4 \u003c \ubc30\ub2f9\ucd1d\uc561 814\ubc31\ub9cc\uc5d4 \uc218\uc900)\uc758 \uc9c0\uc18d\uac00\ub2a5\uc131 \ub9ac\uc2a4\ud06c\ub3c4 \uc815\ub7c9\ud654\ud558\uc9c0 \uc54a\uc558\ub2e4.","TDnet \uc6d0\ubcf8 \uc11c\ubc84(release.tdnet.info)\ub294 \uac8c\uc2dc \ud6c4 \uc57d 1\uac1c\uc6d4\uc774 \uc9c0\ub09c PDF\ub97c 404\ub85c \ub0b4\ub824 2025-09-08\u00b72026-06-10 \u77ed\u4fe1\uc740 IRBANK \ubbf8\ub7ec(f.irbank.net)\uc5d0\uc11c \ucde8\ub4dd\ud588\ub2e4. \ubbf8\ub7ec \ud30c\uc77c\uc758 \uc6d0\ubcf8 \ub3d9\uc77c\uc131\uc740 \ubb38\uc11cID(14012025090855