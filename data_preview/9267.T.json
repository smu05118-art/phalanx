c9\uade0 110.33 (Q1 \ub2e8\uc21c\ud3c9\uade0 107.87 \ub300\ube44 +2.47pt \uacc4\uc0b0) | **up** |\n| 9267.T \uc8fc\uac00\u00b7\uc218\uc775\ub960 \ubc0f 52\uc8fc \uc885\uac00 \ubc94\uc704 | 2026-08-21 \uc885\uac00 3,740\uc5d4, 3M +4.03%, 6M -16.89%, 52\uc8fc \uc885\uac00 3,175~5,400\uc5d4 | **\ud63c\uc7ac** |\n| \uacb0\uc0b0 \ud6c4 2026-07 \uc804\uc810\u00b7\uae30\uc874\uc810 \ub9e4\ucd9c \uc804\ub144\ub3d9\uc6d4\ube44 (100=\uc804\ub144\ub3d9\uc6d4) | \uc804\uc810 105.0\u00b7\uae30\uc874\uc810 97.9(\uac1d\uc218 100.3\u00b7\uac1d\ub2e8\uac00 97.6), \uc804\uc810\uc740 6\uc6d4 111.1 \ub300\ube44 -6.10pt\u00b7Q2 \ud3c9\uade0 110.33 \ub300\ube44 -5.33pt | **down** |\n\n\uc9c1\uc804 \uc5f0\uacb0: **FY2026/6 3Q \ub204\uacc4 (2025-06-21~2026-03-20), 2026-04-28 \ubc1c\ud45c** \u2014 \ub9e4\ucd9c 161,710\u00b7\uc601\uc5c5\uc775 8,022\u00b7\uacbd\uc0c1\uc775 8,168\u00b7\uc21c\uc775 5,621\ubc31\ub9cc\uc5d4. 4Q \ub2e8\ub3c5\uc740 \ub9e4\ucd9c 58,928\u00b7\uc601\uc5c5\uc775 2,963\u00b7\uacbd\uc0c1\uc775 2,989\u00b7\uc21c\uc775 2,254\ubc31\ub9cc\uc5d4(\ub204\uacc4 \ucc28\uac10 \uacc4\uc0b0). Q2 \uc6d4\ucc28 \uac00\uc18d\uc740 \uac15\ud55c \ub9c8\uac10 \uc2e4\uc801\uacfc \uac19\uc740 \ubc29\ud5a5\uc774\uc9c0\ub9cc, \uacb0\uc0b0 \ud6c4 7\uc6d4 \uc804\uc810 105.0\u00b7\uae30\uc874\uc810 97.9\ub85c FY2027/6 \ucd08\ubc18\uae4c\uc9c0 \uc774\uc5b4\uc9c0\uc9c0\ub294 \uc54a\uc558\ub2e4.\n\n## \ucee8\uc13c\uc11c\uc2a4\u00b7priced-in\u00b7\ubc38\ub958\uc5d0\uc774\uc158\n\n- \ucee8\uc13c\uc11c\uc2a4: FY2027/6 \uacbd\uc0c1\uc774\uc775 \ucee8\uc13c\uc11c\uc2a4, \ubc31\ub9cc\uc5d4 12,232, gap +1.09% \u2014 \ud68c\uc0ac \uacbd\uc0c1\uc775 \uacc4\ud68d 12,100 \ub300\ube44 \ucee8\uc13c\uc11c\uc2a4\uac00 1.09% \ub192\ub2e4(\uacc4\uc0b0). \ubaa9\ud45c\uc8fc\uac00 5,067\uc5d4, \ud604 \uc8fc\uac00 \ub300\ube44 +35.47%.\n- \uc120\ubc18\uc601 \ud504\ub85d\uc2dc: **25.4%** \u2014 2026-08-21 \uc885\uac00\uc758 52\uc8fc \uc885\uac00 \ubc34\ub4dc \ub0b4 \uae30\uacc4\uc801 \uc704\uce58\ub2e4: `(3,740-3,175)\u0