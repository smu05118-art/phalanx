. PBR \ubc34\ub4dc \ud558\ub2e8 0.32\ubc30\ub97c \uc801\uc6a9\ud558\uba74 \ud6e8\uc52c \ub0ae\uc544\uc9c0\uc9c0\ub9cc \uadf8 \uc218\uc900\uc740 2010\ub144\ub300 \uad6d\uba74\uc758 \uac12\uc774\ub77c \ud604\uc7ac \uc7ac\ubb34\uad6c\uc870(\uc790\uae30\uc790\ubcf8\ube44\uc728 56.7%)\uc5d0 \uadf8\ub300\ub85c \uc801\uc6a9\ud558\uc9c0 \uc54a\uc558\ub2e4."],"review_meta":{"reviewed_on":"2026-08-27","model":"gpt-5.6-sol/ultra","verdict":"upgraded","changes":["jp_monthly_ready.json\uc758 2026-08-24 \uc2e4\ubb3c\uc5d0\uc11c 7\uc6d4 m=80.19\u00b7raw=96.2(YoY -3.8%)\ub97c \ud655\uc778\ud574 \ucd5c\uc2e0\uc6d4\u00b7\ubc29\ud5a5\u00b7\ud310\uc815 \ub17c\uac70\ub97c \uac31\uc2e0\ud588\ub2e4.","Yahoo Finance 2\ub144 \uc77c\ubcc4 \uc885\uac00\ub97c 2025-08-21~2026-08-20\ub85c \uc808\ub2e8\ud574 52\uc8fc \uc885\uac00 \uc800\uc810\uc774 2,803\uc5d4(2025-09-02)\uc784\uc744 \uc7ac\ud655\uc778\ud558\uace0 \ub2e4\uc6b4\uc0ac\uc774\ub4dc\ub97c -26.2%\ub85c \uc218\uc815\ud588\ub2e4.","JPX \uacf5\uc2dd FY2026/3 \u6c7a\u7b97\u77ed\u4fe1\ub97c \ud655\ubcf4\ud574 \uc9c1\uc804 EPS\ub97c 143.30\uc5d4\uc73c\ub85c \uc815\uc815\ud558\uace0 2\ucc28 \uc18c\uc2a4 \ud55c\uacc4\ub97c \ud574\uc18c\ud588\ub2e4.","\uc6d0\ubcf8 \ub808\uc9c0\uc2a4\ud2b8\ub9ac \uba54\ud0c0\ub97c generated=2026-08-24\u00b7cover=216\u00b7span=2006-04~2026-07\ub85c \uac31\uc2e0\ud558\uace0 m/raw \uacb0\uce21 \ubc94\uc704\ub97c \uad6c\ubd84\ud588\ub2e4."],"recalc_check":{"upside":{"method":"price_target","price_base":3800,"price_src":"Yahoo Finance chart API 2664.T \uc77c\ubd09, 2026-08-20 \uc885\uac00","targets":{"base":4214,"bull":null,"bear":2803}},"consensus":{"value":null,"own":null,"unit":"","formula":"own_over_value","note":"minkabu \uc560\ub110\ub9ac\uc2a4\ud2b8 \ud56d\ubaa9\uc774 \u5bfe\u8c61\u5916\uc774\uace0 kabutan\uc5d0\ub3c4 \uc560\ub110\ub9ac\uc2a4\ud2b8 \ucee8\uc13c\uc11c\uc2a4 \uc218\uce58\uac00 \uc5c6\uc5b4 \ubbf8\ud655\ubcf4\ub2e4."},"verdict":"pass"}},"md":"# Cawachi(\u30ab\u30ef\u30c1\u85ac\u54c1) 2664.T \u2014 2026-Q2 \ub9ac\ubdf0\n\n\u003e **\ubc1c\ud45c\uc77c 2026-07-29(15:30 JST) \ud655\uc815.** \uc2a4\ud399\uc0c1 '\ubbf8\ud655\ubcf4'\uc600\ub358 \ubc1c\ud45c\uc77c\uc744 TDnet \uacf5\uc2dc\ubaa9\ub85d\uc5d0\uc11c \uc9c1\uc811 \ud655\uc815\ud588\ub2e4.\n\u003e \uadfc\uac70: \u300c2027\u5e74\uff13\u6708\u671f \u7b2c\uff11\u56db\u534a\u671f\u6c7a\u7b97\u77ed\u4fe1\u3014\u65e5\u672c\u57fa\u6e96\u3015\uff08\u9023\u7d50\uff09\u300d pubdate `2026-07-29 15:30:00`\n\u003e ([\uacf5\uc2dc\ubaa9\ub85d](https://webapi.yanoshin.jp/webapi/tdnet/list/2664.json?limit=60) \u00b7 [\u77ed\u4fe1 PDF](https://webapi.yanoshin.jp/rd.php?https://www.release.tdnet.info/inbs/140120260727500251.pdf))\n\u003e \uce98\ub9b0\ub354 2026-Q2\uc5d0 \ub300\uc751\ud558\ub294 \ud68c\uacc4\ubd84\uae30\ub294 FY2027/3 Q1, \u77ed\u4fe1 \ub300\uc0c1\uae30\uac04 **2026-03-16 ~ 06-15**.\n\n**\ud310\uc815: \uc911\ub9bd** \u2014 \ubd84\uae30 \uc601\uc5c5\uc774\uc775 +15.9%\uc640 4~6\uc6d4 \uc6d4\ucc28 \ud50c\ub7ec\uc2a4 \uc804\ud658\uc740 \uc2e4\uc81c \uac1c\uc120\uc774\uc9c0\ub9cc, \ucd5c\uc2e0 7\uc6d4 \uc6d4\ucc28\uac00 -3.8%\ub85c \ub2e4\uc2dc \uaebe\uc600\uace0 \ud68c\uc0ac \ud1b5\uae30 \uac00\uc774\ub358\uc2a4\ub3c4 \uc601\uc5c5\uc774\uc775 \u25b324.8%\ub85c \ubb34\uc218\uc815\uc778 \uc0c1\ud0dc\uc5d0\uc11c \uc8fc\uac00\ub9cc 3M +24% \uc62c\ub77c PBR\uc774 2010\ub144 \uc774\ud6c4 \ubc34\ub4dc \uc0c1\ub2e8 \ubd80\uadfc(84%)\uae4c\uc9c0 \uc654\ub2e4.\n\n## 1. \ubc1c\ud45c \uc2e4\uc801 (\u6c7a\u7b97\u77ed\u4fe1 1\ud398\uc774\uc9c0 \uc2e4\uce21, \ub2e8\uc704 \u767e\u4e07\u5186)\n\n| \ud56d\ubaa9 | FY2027/3 Q1 | \uc804\ub144\ub3d9\uae30 | YoY |\n|---|---|---|---|\n| \u58f2\u4e0a\u9ad8 | **71,981** | 71,025 | **+1.3%** |\n| \u55b6\u696d\u5229\u76ca | **1,447** | 1,249 | **+15.9%** |\n| \u7d4c\u5e38\u5229\u76ca | **1,710** | 1,611 | **+6.2%** |\n| \u89aa\u4f1a\u793e\u682a\u4e3b\u5e30\u5c5e \u56db\u534a\u671f\u7d14\u5229\u76ca | **1,102** | 1,045 | **+5.5%** |\n| EPS | 49.36\uc5d4 | 46.79\uc5d4 | \u2014 |\n| BPS / \uc790\uae30\uc790\ubcf8\ube44\uc728 | 5,139.18\uc5d4 / 56.7% | (2026/3\ub9d0 5,188.27\uc5d4 / 58.0%) | \u2014 |\n\n\ud68c\uc0ac \ud1b5\uae30 \uac00\uc774\ub358\uc2a4(FY2027/3, **\uc218\uc815 \uc5c6\uc74c**): \ub9e4\ucd9c 285,000(+0.2%) \u00b7 \uc601\uc5c5\uc774\uc775 5,100(\u25b324.8%) \u00b7 \uacbd\uc0c1 6,000(\u25b324.0%) \u00b7 \uc21c\uc774\uc775 3,000(\u25b36.3%) \u00b7 EPS 134.32\uc5d4. \uc0c1\ubc18\uae30 \ub204\uacc4\ub294 \ub9e4\ucd9c 145,800(+0.3%) \u00b7 \uc601\uc5c5\uc774\uc775 3,000(\u25b36.5%).\n\u2192 Q1\uc5d0 \uc601\uc5c5\uc774\uc775\uc744 \ud1b5\uae30 \uac00\uc774\ub358\uc2a4\uc758 28.4% \uc18c\ud654\ud588\ub294\ub370\ub3c4 \uac00\uc774\ub358\uc2a4\ub97c \uc62c\ub9ac\uc9c0 \uc54a\uc558\ub2e4. \ud68c\uc0ac\uac00 \ud558\ubc18\uae30 \ub9c8\uc9c4 \uc545\ud654\ub97c \uc0c1\uc815\ud558\uace0 \uc788\ub2e4\ub294 \ub73b\uc73c\ub85c, \uc774\ubc88 \ubd84\uae30 \ud638\uc870\ub97c \ud1b5\uae30\ub85c \uc5f0\uc7a5\ud574 \uc77d\uc73c\uba74 \uc548 \ub41c\ub2e4.\n\n## 2. \ubcf4\uc720 \ub370\uc774\ud130 \u2014 \ub85c\uceec \uc6d4\ucc28 (jp_monthly_ready.json #2664, form=idx)\n\n| \uc6d4 | \uc9c0\uc218 | YoY |\n|---|---|---|\n| 2026-04 | 94.64 | +1.3% |\n| 2026-05 | 90.14 | +1.8% |\n| 2026-06 | 80.77 | **+0.4%** |\n| 2026-07 | 80.19 | **-3.8%** |\n\nQ1\uc5d0 \ub300\uc751\ud558\ub294 4~6\uc6d4 \ubc29\ud5a5\uc740 **up**\uc774\ub2e4. 2025-06 ~ 2026-01\uc740 8\uac1c\uc6d4 \uc5f0\uc18d \ub9c8\uc774\ub108\uc2a4(\u25b32.2% ~ \u25b34.5%)\uc600\uace0 2026-04\ubd80\ud130 3\uac1c\uc6d4 \ud50c\ub7ec\uc2a4\ub85c \ub3cc\uc544\uc130\ub2e4. \ub2e4\ub9cc \ud3ed\uc774 +1.3 \u2192 +1.8 \u2192 +0.4%\ub85c \uc881\uc544\uc9c4 \ub4a4 \ubd84\uae30 \ubc16 \ucd5c\uc2e0\uc6d4\uc778 7\uc6d4\uc5d0 **-3.8%**\ub85c \uc7ac\ud558\ub77d\ud588\ub2e4. 4~6\uc6d4\uc740 \u77ed\u4fe1\uc758 \ub9e4\ucd9c +1.3%\uc640 \ubd80\ud638\u00b7\ud06c\uae30\uac00 \uc815\ud569\ud558\uc9c0\ub9cc, 7\uc6d4\uc740 \uac1c\uc120 \uc9c0\uc18d\uc744 \ud655\uc778\ud574 \uc8fc\uc9c0 \uc54a\ub294\ub2e4.\n\n**\ud615\uc2dd \uc8fc\uc758:** form=idx\ub294 \ub808\ubca8(80.19 \ub4f1)\uc758 \uc808\ub300 \uc758\ubbf8\uac00 \uc5c6\ub2e4. \ubc29\ud5a5\uacfc YoY\ub9cc \uc720\ud6a8\ud558\ub2e4. \uc6d0\ubcf8 \uc2e4\ubb3c \uba54\ud0c0\ub294 generated **2026-08-24**, cover **216**, span **2006-04~2026-07**\uc774\ub2e4.\n\n## 3. \uc9c1\uc804 \uc2e4\uc801 \uc5f0\uacb0\n\n\uc9c1\uc804 \ubb38\uc11c\ub294 FY2026/3 \ud1b5\uae30 \uacb0\uc0b0(2026-04-28 \ubc1c\ud45c). JPX \uacf5\uc2dd \uacf5\uc2dc \uc544\uce74\uc774\ube0c\uc758 \uc6d0\ubb38 \u77ed\u4fe1 \uc2e4\uce21 \uae30\uc900 \ub9e4\ucd9c 284,492(\u25b31.2%) \u00b7 \uc601\uc5c5\uc774\uc775 6,779(\u25b39.1%) \u00b7 \uc21c\uc774\uc775 3,200(\u25b334.5%) \u00b7 EPS 143.30\uc5d4\uc774\uc5c8\ub2e4. \uc989 **\uac10\uc775 \uae30\uc870 \u2192 \uc774\ubc88 Q1 \uc99d\uc775 \uc804\ud658**\uc774\ub2e4. \ud1b5\uae30 \uac00\uc774\ub358\uc2a4(285,000 / 5,100 / 6,000 / 3,000)\ub97c \uc774 FY26 \uc2e4\uc801\uc73c\ub85c \ub098\ub204\uba74 \u77ed\u4fe1 \uae30\uc7ac \uc99d\uac10\ub960(+0.2% / \u25b324.8% / \u25b324.0% / \u25b36.3%)\uacfc \uc77c\uce58\ud55c\ub2e4. (\uae30\uc874 TDnet \uc9c1\uc811 URL\uc740 404\uc600\uc73c\ub098 [JPX \uc6d0\ubb38](https://www2.jpx.co.jp/disc/26640/140120260427511385.pdf)\uc744 \ud655\ubcf4\ud588\ub2e4.)\n\n## 4. \ucee8\uc13c\uc11c\uc2a4 \u00b7 priced-in\n\n\ucee8\uc13c\uc11c\uc2a4\ub294 **\ubbf8\ud655\ubcf4(null)**\ub2e4. minkabu \uc885\ubaa9 \ud398\uc774\uc9c0(2026-08-22 \uc870\ud68c)\uc5d0\uc11c \uc560\ub110\ub9ac\uc2a4\ud2b8 \ud56d\ubaa9\uc774 \u300c\u5bfe\u8c61\u5916\u300d \u2014 \uc140\uc0ac\uc774\ub4dc \ucee4\ubc84\ub9ac\uc9c0 \uc790\uccb4\uac00 \uc5c6\ub2e4. kabutan \ubb34\ub8cc \ud398\uc774\uc9c0\uc5d0\ub3c4 \uc218\uce58\uac00 \uc5c6\ub2e4. \ud68c\uc0ac \ud1b5\uae30 \uac00\uc774\ub358\uc2a4\ub294 \ucee8\uc13c\uc11c\uc2a4\uac00 \uc544\ub2c8\ubbc0\ub85c \uac2d \uacc4\uc0b0\uc740 \ud558\uc9c0 \uc54a\ub294\ub2e4. (minkabu \u76ee\u6a19\u682a\u4fa1 2,451\uc5d4\uc740 \uac1c\uc778\uc608\uc0c1 \uae30\ubc18 \uac12\uc774\ub77c \ucee8\uc13c\uc11c\uc2a4\ub85c \uc4f0\uc9c0 \uc54a\uc558\ub2e4.)\n\n\uc8fc\uac00\ub294 3,800\uc5d4(2026-08-20 \uc885\uac00), 3M **+24.18%**, 1M +12.43%, 52\uc8fc \uc885\uac00 \ubc34\ub4dc 2,803~3,850. \uc9c0\uae08 \uac12\uc740 52\uc8fc \uc885\uac00 \uace0\uc810 \ub300\ube44 1.3% \uc544\ub798\ub2e4. \ubc18\uba74 \ub370\uc774\ud130\uac00 \ubcf4\uc5ec\uc900 \uac1c\uc120\ud3ed\uc740 \ub9e4\ucd9c +1.3%, 4~6\uc6d4 \uc6d4\ucc28 YoY +0.4~+1.8%\uc600\uace0 \ucd5c\uc2e0 7\uc6d4\uc740 -3.8%\ub85c \ub2e4\uc2dc \ub0b4\ub824\uac14\ub2e4. **\uc8fc\uac00 \uc0c1\uc2b9\ubd84\uc744 \uc2e4\uc801\u00b7\uc6d4\ucc28\ub85c \uc124\uba85\ud560 \uc218 \uc788\ub294 \ubaab\uc740 \uba85\ubc31\ud788 \uc77c\ubd80\uc5d0 \ubd88\uacfc\ud558\ub2e4.** \uac19\uc740 \uae30\uac04\uc5d0 \uc2e4\uce21 \ud655\uc778\ub418\ub294 \uc774\ubca4\ud2b8\ub294 (a) 7/29 \u77ed\u4fe1\uc758 \uc601\uc5c5\uc774\uc775 +15.9%, (b) 8/3 \u300c\u81ea\u5df1\u682a\u5f0f\u53d6\u5f97\u306b\u4fc2\u308b\u4e8b\u9805\u306e\u6c7a\u5b9a\u306b\u95a2\u3059\u308b\u304a\u77e5\u3089\u305b\u300d \uacf5\uc2dc \ub450 \uac74\uc774\ub2e4. \ub2e4\ub9cc \uac01 \uc774\ubca4\ud2b8\uac00 +24% \uc911 \uba87 %p\ub97c \ub9cc\ub4e4\uc5c8\ub294\uc9c0\ub294 \uc774 \uc138\uc158\uc758 \ub370\uc774\ud130\ub85c \uadc0\uc18d\uc2dc\ud0ac \uc218 \uc5c6\ub2e4. **\ub098\uba38\uc9c0 \uc0c1\uc2b9\ubd84\uc758 \uc6d0\uc778\uc740 \ubaa8\ub978\ub2e4** \u2014 \ucd94\uc815\ud574 \uc4f0\uc9c0 \uc54a\ub294\ub2e4.\n\n## 5. \uc5c5\u00b7\ub2e4\uc6b4\uc0ac\uc774\ub4dc\n\n| | \uac12 | \uadfc\uac70 |\n|---|---|---|\n| \uc5c5\uc0ac\uc774\ub4dc | **+10.9%** (4,214\uc5d4) | PBR 0.82\ubc30(irbank \uc2e4\uce21 2010\ub144 \uc774\ud6c4 \ubc34\ub4dc \uc0c1\ub2e8) \u00d7 BPS 5,139.18\uc5d4(FY27 Q1\ub9d0 \u77ed\u4fe1) |\n| \ub2e4\uc6b4\uc0ac\uc774\ub4dc | **\u25b326.2%** (2,803\uc5d4) | 2026-08-20 \uae30\uc900 \uc9c1\uc804 365\uc77c \uc885\uac00 \uc800\uc810 \ud68c\uadc0(PBR \uc57d 0.545\ubc30). \uae30\uc900\uac00\u00b7\ubaa9\ud45c\uac00 \ubaa8\ub450 \uc870\uc815 \uc804 \uc77c\ubcc4 \uc885\uac00 |\n\n\ud604\uc7ac PBR 0.739