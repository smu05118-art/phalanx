ownloads/jem_data/ppi/ \ub514\ub809\ud130\ub9ac\uc5d0 catalog.json \ub2e8 1\uac1c \ud30c\uc77c\ubfd0\uc774\uba70 JSON\uc740 55\uac1c \uacc4\uc5f4 \uc815\uc758\uc758 \ubc30\uc5f4\uc774\ub2e4. \ub530\ub77c\uc11c FPY_2802 \uad00\ub828 4\uacc4\uc5f4 \uc804\ubd80\ub97c \uc6f9 \uc2e4\uce21\uc73c\ub85c \ub300\uccb4 \ucde8\ub4dd\ud588\ub2e4(BLS \uacf5\uac1c API 2\uacc4\uc5f4 + BOJ CGPI \ud50c\ub7ab\ud30c\uc77c 2\uacc4\uc5f4). \uc2a4\ud399\uc758 \uc720\uc77c\ud55c data_ref\uc5d0\uc11c \uc218\uce58\ub97c \uc778\uc6a9\ud55c \uac83\uc774 \uc544\ub2c8\ub77c \uadf8 \uc815\uc758\ub9cc \uc0ac\uc6a9\ud588\ub2e4\ub294 \uc810\uc744 \uba85\uc2dc\ud55c\ub2e4.","\uc2a4\ud399 \uc9c0\uc815 \uc18c\uc2a4\uc778 FRED\ub294 \ubcf8 \uc2e4\ud589 \ud658\uacbd\uc5d0\uc11c \uc811\uadfc \uc2e4\ud328 \u2014 fredgraph.csv\ub294 python urllib/curl \ubaa8\ub450 timeout(errno 60, HTTP/2 INTERNAL_ERROR), \uc2dc\ub9ac\uc988 \ud398\uc774\uc9c0\uc640 /data/*.txt\ub294 WebFetch\uc5d0\uc11c HTTP 403. \uc6b0\ud68c\ub85c \uc6d0(\u539f)\ucd9c\ucc98\uc778 BLS Public Data API\ub97c \uc0ac\uc6a9\ud588\uace0, FRED PCU311311\uc758 BLS \uc6d0\uacc4\uc5f4 ID\ub294 PCU311---311---(\uc81c\ub85c\ud328\ub529 \ud615\ud0dc)\uc774\ub2e4. \uac12 \uc790\uccb4\ub294 BLS \uc6d0\ubcf8\uc774\ubbc0\ub85c FRED\uc640 \ub3d9\uc77c\ud558\ub098 FRED \ud398\uc774\uc9c0\ub85c \uc9c1\uc811 \ub300\uc870\ud558\uc9c0\ub294 \ubabb\ud588\ub2e4.","2802\ub294 \uc6d4\ucc28(\uc6d4\uac04) \ub9e4\ucd9c \uacf5\uc2dc\uac00 \uc5c6\ub294 \ub300\ud615\uc8fc\ub85c \ub85c\uceec \uc6d4\ucc28 \ub370\uc774\ud130\uac00 \uc874\uc7ac\ud558\uc9c0 \uc54a\ub294\ub2e4 \u2014 `python3 _jmq.py 2802 24` \uc2e4\ud589 \uacb0\uacfc \u300cNOT FOUND: 2802\u300d. \ub530\ub77c\uc11c \uc6d4\ucc28 \uae30\ubc18 \uc2e4\uc801 \uc120\ud589 \ud310\ub2e8\uc740 \ubd88\uac00\ud558\uba70 \ubd84\uae30 \uacf5\uc2dc\u00b7\ud310\uac00 PPI\u00b7\uc8fc\uac00\ub85c\ub9cc \uad6c\uc131\ud588\ub2e4.","FY2026/3 \ud1b5\uae30 \uc2e4\uc801(\uc9c1\uc804 \uc2e4\uc801 \uc5f0\uacb0)\uc758 1\ucc28 \uc18c\uc2a4\uc778 2026-05-07 \u300c2026\u5e743\u6708\u671f \u6c7a\u7b97\u77ed\u4fe1\u300d PDF(\ubb38\uc11c\ubc88\ud638 140120260501516433)\ub294 TDnet\uc5d0\uc11c HTTP 404\ub85c \ub9cc\ub8cc\ub418\uc5b4 \ud30c\uc2f1 \ubd88\uac00. \ub300\uc2e0 2026-08-06 \u300c\u901a\u671f\u9023\u7d50\u696d\u7e3e\u4e88\u60f3\u306e\u4fee\u6b63\u300d PDF\uc758 \u300c(\u3054\u53c2\u8003) \u524d\u671f\u5b9f\u7e3e\uff082026\u5e743\u6708\u671f\uff09\u300d \ud589\uc5d0\uc11c \uc218\uce58\ub97c \ucde8\ud588\ub2e4(\ub9e4\ucd9c 1,583,719 / \u4e8b\u696d\u5229\u76ca 181,163 / \uc21c\uc774\uc775 134,675 / EPS 138.36). \uc138\uadf8\uba3c\ud2b8\ubcc4 \ud1b5\uae30 \uc2e4\uc801\uc740 \ubbf8\ud655\ubcf4.","\ucee8\uc13c\uc11c\uc2a4\ub294 \ub808\uc9c0\uc2a4\ud2b8\ub9ac \uc9c0\uc815 \uc18c\uc2a4(kabutan/minkabu)\uac00 \uc544\ub2c8\ub77c kabuyoho.jp\uc5d0\uc11c \ud655\ubcf4\ud588\ub2e4. \ud655\ubcf4\ub41c \uac83\uc740 FY2027/3 '\ud1b5\uae30' \ucee8\uc13c\uc774\uba70 2026-Q2(FY2027/3 Q1) '\ub2e8\uc77c\ubd84\uae30' \ucee8\uc13c\uc740 \ub05d\ub0b4 \ubbf8\ud655\ubcf4 \u2192 gap_pct(-8.2%)\ub294 \uc2e4\uc801 \uc11c\ud504\ub77c\uc774\uc988\uac00 \uc544\ub2c8\ub77c '\ud68c\uc0ac \uac00\uc774\ub358\uc2a4 vs \ud1b5\uae30 \ucee8\uc13c' \uac2d\uc774\ub2e4. \ub610\ud55c kabuyoho\uc758 \u300c\u55b6\u696d\u5229\u76ca/\u7d4c\u5e38\u5229\u76ca\u300d \ub77c\ubca8\uc740 IFRS \uc801\uc6a9\uc0ac\uc778 2802\uc758 \u4e8b\u696d\u5229\u76ca/\u55b6\u696d\u5229\u76ca\uacfc 1:1 \ub300\uc751\ud558\uc9c0 \uc54a\ub294\ub2e4. \ub530\ub77c\uc11c \uc0ac\uc774\ud2b8\uc758 197,643\ubc31\ub9cc\uc5d4(\u7d4c\u5e38\u5229\u76ca \ub77c\ubca8)\uc740 \ud68c\uc0ac \u4e8b\u696d\u5229\u76ca 202,000\uacfc\uc758 \uc9c1\uc811 \ube44\uad50 \ubc0f \ubaa9\ud45c\uac00 \uadfc\uac70\uc5d0\uc11c \uc81c\uc678\ud588\uace0, \uc0c1\ud5a5 \ubc18\uc601 \uc9c0\uc5f0 \uac00\ub2a5\uc131\uc740 \ub9e4\ucd9c \ucee8\uc13c 1,725,157\uacfc \ud68c\uc0ac \ub9e4\ucd9c \uac00\uc774\ub358\uc2a4\ub9cc\uc73c\ub85c \uc81c\ud55c\ud574 \uc11c\uc220\ud588\ub2e4.","\ubaa9\ud45c\uc8fc\uac00 \ucee8\uc13c\uc11c\uc2a4, \ucee4\ubc84\ub9ac\uc9c0 \uc560\ub110\ub9ac\uc2a4\ud2b8 \uc218, \ud22c\uc790\uc758\uacac \ubd84\ud3ec\ub294 kabuyoho \ud398\uc774\uc9c0\uc5d0 \ub178\ucd9c\ub418\uc9c0 \uc54a\uc544 \ubbf8\ud655\ubcf4(null \ucde8\uae09) \u2014 \uc5c5\u00b7\ub2e4\uc6b4\uc0ac\uc774\ub4dc \uc0b0\uc815\uc5d0 \uc2dc\uc7a5 \ubaa9\ud45c\uc8fc\uac00\ub97c \ubc18\uc601\ud558\uc9c0 \ubabb\ud588\ub2e4.","\uc5c5\u00b7\ub2e4\uc6b4\uc0ac\uc774\ub4dc %\ub294 DCF\ub098 \uc815\uc2dd \uba40\ud2f0\ud50c \ubaa8\ub378\uc774 \uc544\ub2c8\ub77c, \uc2e4\uce21 \uc885\uac00 \ub808\ubca8(52\uc8fc \uace0\uc810 6,175\uc5d4 / 2026-04-16 \uc885\uac00 4,690\uc5d4)\uc744 \uc575\ucee4\ub85c \uc0bc\uace0 \ucee8\uc13cEPS 140.64\uc5d4 \uae30\uc900 PER(43.9\ubc30 / 33.4\ubc30)\ub85c \uad50\ucc28\uac80\uc99d\ud55c \uac04\uc774 \ucd94\uc815\uc774\ub2e4. EPS \ubd84\ubaa8\ub85c \uc4f4 \u671f\u4e2d\u5e73\u5747\u682a\u5f0f\u6570 956,451,886\uc8fc\ub294 Q1 \ub204\uacc4 \uae30\uc900\uc774\uba70 \ud1b5\uae30 \ud3c9\uade0\uc8fc\uc2dd\uc218\uc640\ub294 \ub2e4\ub97c \uc218 \uc788\ub2e4(\uc790\uc0ac\uc8fc \ub9e4\uc785 \uc9c4\ud589 \uc911 \u2014 \uc790\uae30\uc8fc\uc2dd 19,290,839\uc8fc\u219223,173,875\uc8fc).","\uc8fc\uac00\ub294 2026-08-20 \uc885\uac00 5,349\uc5d4(_mkt_fetch \uc2e4\uce21) \uae30\uc900\uc774\ub2e4. kabuyoho\uc5d0\ub294 2026-08-21 15:30 \uc2dc\uc810 5,396\uc5d4\uc774 \ud45c\uc2dc\ub418\uc5b4 1\uc601\uc5c5\uc77c\u00b7\uc57d +0.9% \ucc28\uc774\uac00 \uc788\uc73c\ub098, \uc77c\uad00\uc131\uc744 \uc704\ud574 \uc2e4\uce21 \uc2dc\uacc4\uc5f4(_mkt_fetch/Yahoo chart) \uac12\uc744 \uc804 \uacc4\uc0b0\uc5d0 \uc0ac\uc6a9\ud588\ub2e4. _mkt_fetch\uc758 ret_1y_pct\ub294 null(\ub370\uc774\ud130 \ubd80\uc871)\ub85c 1\ub144 \uc218\uc775\ub960\uc740 \ubbf8\uc0b0\ucd9c.","\ud310\uac00 PPI 4\uacc4\uc5f4\uc740 \uc544\uc9c0\ub178\ubaa8\ud1a0 \uc2e4\uc801\uacfc\uc758 \uc0c1\uad00\uc744 \uc815\ub7c9 \uac80\uc99d\ud558\uc9c0 \uc54a\uc740 \ud504\ub85d\uc2dc \uc9c0\ud45c\ub2e4. \uc774\ubc88 \ubd84\uae30 \u4e8b\u696d\u5229\u76ca +27.3%\uc758 \uc8fc \uacac\uc778\ucc28\ub294 \ud310\uac00\uac00 \uc544\ub2c8\ub77c \ud5ec\uc2a4\ucf00\uc5b4 \ub4f1 \uc138\uadf8\uba3c\ud2b8\uc758 \uc804\uc790\uc7ac\ub8cc(ABF \ub4f1 \uace0\uc131\ub2a5 \uae30\ud310 \uc18c\uc7ac) \ubb3c\ub7c9\u00b7\ubbf9\uc2a4\uc774\uba70(\uc0ac\uc5c5\uc774\uc775 +63.3%), PPI 4\uacc4\uc5f4\uc740 \uc870\ubbf8\ub8cc\u00b7\uc2dd\ud488/\ub0c9\ub3d9\uc2dd\ud488 \ubd80\ubb38\uc758 \ubc30\uacbd \uc124\uba85\uc5d0 \uadf8\uce5c\ub2e4.","\u300c\u4e8b\u696d\u5229\u76ca\u300d\ub294 \uc544\uc9c0\ub178\ubaa8\ud1a0 \uace0\uc720\uc758 IFRS \ub2e8\uacc4\uc774\uc775(\ub9e4\ucd9c\ucd1d\uc774\uc775\uc5d0\uc11c \ud310\ub9e4\ube44\u00b7\uc5f0\uad6c\uac1c\ubc1c\ube44\u00b7\uc77c\ubc18\uad00\ub9ac\ube44 \ucc28\uac10 \ud6c4 \uc9c0\ubd84\ubc95\uc190\uc775 \uac00\uc0b0, \uae30\ud0c0\uc601\uc5c5\uc218\uc775/\ube44\uc6a9 \uc81c\uc678)\uc73c\ub85c \uc77c\ubcf8 \ud68c\uacc4\uae30\uc900 \uc601\uc5c5\uc774\uc775\uacfc \uc9c1\uc811 \ube44\uad50\ub418\uc9c0 \uc54a\ub294\ub2e4. \ubcf8 \ubb38\uc11c\ub294 \u77ed\u4fe1 P/L\uc0c1 \u300c\u55b6\u696d\u5229\u76ca\u300d(\ub2f9\ubd84\uae30 55,895 / \uc804\ub144\ub3d9\uae30 49,380)\ub3c4 \ubcd1\uae30\ud588\ub2e4.","\ubc1c\ud45c \ub2f9\uc77c(2026-08-06) \uacf5\uc2dc\uac00 15:30 \uc7a5 \ub9c8\uac10 \ud6c4\uc5ec\uc11c '\ubc1c\ud45c\uc77c \uc885\uac00 \ubc18\uc751'\uc740 8/7\uc744 \ubc18\uc751 \uccab \uac70\ub798\uc77c\ub85c \uac04\uc8fc\ud574 \uacc4\uc0b0\ud588\ub2e4. 8/5\uc758 +7.7% \uae09\ub4f1(4,953\u21925,333)\uc740 \ubc1c\ud45c \uc804\uc77c \uc6c0\uc9c1\uc784\uc73c\ub85c \uc2e4\uc801 \uacf5\uc2dc\uc640 \uc9c1\uc811 \uc778\uacfc\ub97c \ud655\uc778\ud558\uc9c0 \ubabb\ud588\ub2e4(\uc139\ud130\u00b7\uc218\uae09 \uc694\uc778 \uac00\ub2a5).","\ubcf8 \ubb38\uc11c\ub294 \ud22c\uc790\ud310\ub2e8 \ucc38\uace0\uc6a9\uc774\uba70 \ud22c\uc790 \uad8c\uc720\uac00 \uc544\ub2d9\ub2c8\ub2e4."],"md":"# Ajinomoto (2802.T) \u2014 2026-Q2 \ub9ac\ubdf0\n\n\u003e **\ubcf8 \ubb38\uc11c\ub294 \ud22c\uc790\ud310\ub2e8 \ucc38\uace0\uc6a9\uc774\uba70 \ud22c\uc790 \uad8c\uc720\uac00 \uc544\ub2d9\ub2c8\ub2e4.**\n\u003e tier=standard \u00b7 frame=standard_light \u00b7 \uc791\uc131 2026-08-22\n\n**\ubd84\uae30 \ub300\uc751** \u2014 2802\ub294 3\uc6d4\uacb0\uc0b0\uc0ac\ub2e4. \uce98\ub9b0\ub354 2026-Q2(4~6\uc6d4)\uc5d0 \ub05d\ub098\ub294 \uacb0\uc0b0\uae30\uac04\uc740 **FY2027/3 \uc81c1\ubd84\uae30**\uc774\uba70, \u77ed\u4fe1 \ud45c\uc9c0 \uc6d0\ubb38 \u300c1\uff0e2027\u5e743\u6708\u671f\u7b2c1\u56db\u534a\u671f\u306e\u9023\u7d50\u696d\u7e3e\uff08**2026\u5e744\u67081\u65e5\uff5e2026\u5e746\u670830\u65e5**\uff09\u300d\ub85c \ud655\uc778\ud588\ub2e4.\n**\ubc1c\ud45c\uc77c 2026-08-06(\ubaa9) 15:30** \u2014 TDnet \u300c2027\u5e743\u6708\u671f \u7b2c1\u56db\u534a\u671f\u6c7a\u7b97\u77ed\u4fe1\u3014IFRS\u3015\uff08\u9023\u7d50\uff09\u300d \ubb38\uc11c\ubc88\ud638 `140120260805509556` (yanoshin API id=1271412). \ub3d9\uc77c \uc2dc\uac01 \u300c\u901a\u671f\u9023\u7d50\u696d\u7e3e\u4e88\u60f3\u306e\u4fee\u6b63\u300d(`140120260805509642`) \ub3d9\uc2dc \uacf5\uc2dc.\n\n## \ud310\uc815: \uc911\ub9bd\n\n\ub9e4\ucd9c +13.2%\u00b7\u4e8b\u696d\u5229\u76ca +27.3%\uc5d0 \ud1b5\uae30 \uac00\uc774\ub358\uc2a4 \uc0c1\ud5a5(\u4e8b\u696d\u5229\u76ca 1,970\uc5b5\u21922,020\uc5b5\uc5d4)\uae4c\uc9c0 \ud655\uc778\ub41c \uba85\ubc31\ud55c \ud638\uc2e4\uc801\uc774\ub098, 6\uac1c\uc6d4 \uc8fc\uac00 +20.6% \uc120\ubc18\uc601\uacfc \ucee8\uc13cEPS 140.6\uc5d4 \uae30\uc900 **PER 38.0\ubc30(\uacc4\uc0b0)** \ubc38\ub958 \ubd80\ub2f4\uc774 \uc774\ub97c \uc0c1\uc1c4\ud55c\ub2e4. \uc0c1\ub2e8 +15.4% / \ud558\ub2e8 -12.3%\ub85c \ube44\ub300\uce6d\uc774 \ud06c\uc9c0 \uc54a\ub2e4.\n\n## 1. \uc2e4\uc801 \uc2e4\uce21 (FY2027/3 Q1 \u00b7 IFRS \uc5f0\uacb0 \u00b7 \ubc31\ub9cc\uc5d4)\n\n| \ud56d\ubaa9 | \ub2f9\ubd84\uae30 | \uc804\ub144\ub3d9\uae30 | YoY | \ud1b5\uae30 \uac00\uc774\ub358\uc2a4 \ub300\ube44 \uc9c4\ucc99 |\n|---|---:|---:|---:|---:|\n| \u58f2\u4e0a\u9ad8 | 412,105 | 364,008 | **+13.2%** | 23.8% |\n| \u4e8b\u696d\u5229\u76ca | 60,116 | 47,236 | **+27.3%** | **29.8%** |\n| \u55b6\u696d\u5229\u76ca | 55,895 | 49,380 | +13.2% (\uacc4\uc0b0) | \u2014 |\n| \u7a0e\u5f15\u524d\u56db\u534a\u671f\u5229\u76ca | 54,994 | 48,072 | +14.4% | \u2014 |\n| \u89aa\u4f1a\u793e\u6240\u6709\u8005\u5e30\u5c5e\u56db\u534a\u671f\u5229\u76ca | 36,452 | 32,218 | **+13.1%** | 29.5% |\n| \u57fa\u672c\u76841\u682a\u5f53\u305f\u308a\u56db\u534a\u671f\u5229\u76ca | 38.11\uc5d4 | 32.62\uc5d4 | +16.8% (\uacc4\uc0b0) | \u2014 |\n\n\uc138\uadf8\uba3c\ud2b8(\u5104\u5186): \uc870\ubbf8\ub8cc\u00b7\uc2dd\ud488 \ub9e4\ucd9c 2,387(+11.9%)/\u4e8b\u696d\u5229\u76ca 410(+13.0%) \u00b7 \ub0c9\ub3d9\uc2dd\ud488 725(+5.6%)/**21(-23.2%)** \u00b7 **\ud5ec\uc2a4\ucf00\uc5b4 \ub4f1 970(+22.8%)/251(+63.3%)** \u00b7 \uae30\ud0c0 37/16 \u00b7 \uc804\uc0ac\uacf5\ud1b5\ube44 \u25b399.\n**\ud1b5\uae30 \uac00\uc774\ub358\uc2a4 \uc0c1\ud5a5(8/6)**: \ub9e4\ucd9c 1,723,000\u2192**1,732,000**(+9.4% YoY), \u4e8b\u696d\u5229\u76ca 197,000\u2192**202,000**(+11.5%), \uc21c\uc774\uc775 120,000\u2192**123,500**(**\u25b38.3%** YoY), EPS 129.84\uc5d4, \uc804\uc81c\ud658\uc728 1USD=150\uc5d4. \uc0c1\ud5a5\ubd84\uc740 **\ud5ec\uc2a4\ucf00\uc5b4 \ub4f1 \uc138\uadf8\uba3c\ud2b8 \ub2e8\ub3c5** \u2014 AI\u00b7\uc11c\ubc84\u00b7\ub124\ud2b8\uc6cc\ud06c\uc6a9 \uace0\uc131\ub2a5 \uae30\ud310\u5411 \uc804\uc790\uc7ac\ub8cc \ud638\uc870(\ub9e4\ucd9c +90\uc5b5\uc5d4/\u4e8b\u696d\u5229\u76ca +50\uc5b5\uc5d4)\uc774\uace0, \uc870\ubbf8\ub8cc\u00b7\uc2dd\ud488\uacfc \ub0c9\ub3d9\uc2dd\ud488\uc740 \u524d\u56de\u4e88\u60f3 \ub3d9\uacb0\uc774\ub2e4. \uc21c\uc774\uc775\ub9cc \uc5ed\uc131\uc7a5\uc778 \uac83\uc740 \uc804\uae30 \uace0\uc815\uc790\uc0b0 \uc591\ub3c4\uc775 \ubc18\ub3d9(\u5176\u4ed6\u55b6\u696d\u53ce\u76ca 5,293\u21921,841, \u5176\u4ed6\u55b6\u696d\u8cbb\u7528 3,149\u21926,062) \ud0d3\uc774\ub2e4. \uc5f0\uac04\ubc30\ub2f9 \uc608\uc0c1 50\uc5d4(\uc804\uae30 48\uc5d4). \uc720\uc774\uc790\ubd80\ucc44\ub294 CP \ubc1c\ud589\uc73c\ub85c \uc804\uae30\ub9d0 \ub300\ube44 +1,410\uc5b5\uc5d4 \uc99d\uac00\ud55c 6,237\uc5b5\uc5d4.\n\n## 2. \ubcf4\uc720\ub370\uc774\ud130(\ud310\uac00 PPI 4\uacc4\uc5f4) \uc2e4\uce21 \u2014 \u203b \ub85c\uceec\uc740 \uc815\uc758\ub9cc, \uac12\uc740 \uc6f9 \uc2e4\uce21\n\n\ub85c\uceec `jem_data/ppi/catalog.json`\uc740 **\uacc4\uc5f4 \uba54\ud0c0\ub370\uc774\ud130\ub9cc \ubcf4\uc720\ud558\uace0 \uc2dc\uacc4\uc5f4 \uac12\uc774 \uc5c6\uc5b4** 4\uacc4\uc5f4 \uc804\ubd80 \uc6f9\uc5d0\uc11c \uc9c1\uc811 \ucde8\ub4dd\ud588\ub2e4(FRED\ub294 timeout/403 \u2192 BLS \uc6d0\uacc4\uc5f4 API, BOJ\ub294 CGPI \ud50c\ub7ab\ud30c\uc77c).\n\n| \uacc4\uc5f4 (catalog id) | \ucd5c\uc2e0 | \uac12 | YoY | \ubc29\ud5a5 |\n|---|---|---:|---:|:--:|\n| \u7f8e \uc2dd\ud488\uc81c\uc870 PPI (`us_food`, PCU311311) | 2026-07 | 273.716 | +1.06% (\uacc4\uc0b0) | up |\n| \u7f8e \uc758\uc57d\ud488 \uc81c\uc81c PPI (`us_pharma`, PCU325412325412) | 2026-07 | 926.349 | +1.22% (\uacc4\uc0b0) | up |\n| \u65e5 CGPI \u98f2\u98df\u6599\u54c1 (`jp_food`, PRCG20_2200120001) | 2026-07 | 129.5 | **+4.02%** (\uacc4\uc0b0) | up |\n| \u65e5 CGPI \uc758\uc57d\ud488\u9664\u52d5\u7269\u7528 (`jp_pharma`, PRCG20_2200550033) | 2026-07 | 80.7 | **-3.70%** (\uacc4\uc0b0) | down |\n\n**\ud310\uac00 \ud658\uacbd\uc740 \uc544\uc9c0\ub178\ubaa8\ud1a0 \uc2e4\uc801\uc744 \uc644\ub9cc\ud788 \uc704(+)\ub85c \ub048\ub2e4** \u2014 \uad6d\ub0b4 \uc2dd\ud488 \ud310\uac00(\u65e5 CGPI \u98f2\u98df\u6599\u54c1 +4.0%)\uac00 \uc870\ubbf8\ub8cc\u00b7\uc2dd\ud488 \uc138\uadf8\uba3c\ud2b8\uc758 \uac00\uaca9 \uc804\uac00\ub97c \ub4b7\ubc1b\uce68\ud558\uace0 \u7f8e \uc2dd\ud488\u00b7\uc758\uc57d\ud488 PPI\ub3c4 \uc18c\ud3ed \uc0c1\uc2b9\uc774\ub098, \u65e5 \uc57d\uac00 \ub514\ud50c\ub808(-3.7%)\uac00 \ud5ec\uc2a4\ucf00\uc5b4 \uc77c\ubd80\ub97c \uc0c1\uc1c4\ud558\uba70, \ubb34\uc5c7\ubcf4\ub2e4 \uc774\ubc88 \ubd84\uae30 \uc774\uc775 \uae09\uc99d\uc758 \uc2e4\uc81c \uacac\uc778\ucc28\ub294 \ud310\uac00\uac00 \uc544\ub2c8\ub77c **\uc804\uc790\uc7ac\ub8cc \ubb3c\ub7c9**\uc774\ub77c PPI 4\uacc4\uc5f4\uc758 \uc124\uba85\ub825\uc740 \uc81c\ud55c\uc801\uc774\ub2e4.\n\n## 3. \uc9c1\uc804 \uc2e4\uc801 \uc5f0\uacb0 \u00b7 \ucee8\uc13c \u00b7 priced-in \u00b7 \uc5c5\ub2e4\uc6b4\uc0ac\uc774\ub4dc\n\n- **\uc9c1\uc804(FY2026/3 \ud1b5\uae30)**: \ub9e4\ucd9c 1,583,719 / \u4e8b\u696d\u5229\u76ca 181,163 / \uc21c\uc774\uc775 134,675 / EPS 138.36\uc5d4. \uc774\ubc88 Q1 \u4e8b\u696d\u5229\u76ca 60,116\uc740 \uadf8 **33.2%(\uacc4\uc0b0)**\uc5d0 \ud574\ub2f9\ud558\uace0, \ud1b5\uae30 \uac00\uc774\ub358\uc2a4 \uc9c4\ucc99\ub960 29.8%\ub294 **\ubd84\uae30 \uade0\ub4f1 \ubc30\ubd84 \uae30\uc900 25%**\ub97c \uc0c1\ud68c\ud55c\ub2e4. 25%\ub294 \uc2e4\uc99d\ub41c \uacc4\uc808 \ud3c9\uade0\uc774 \uc544\ub2c8\ub2e4. (5/7 \ud1b5\uae30 \u77ed\u4fe1 PDF\ub294 TDnet 404 \ub9cc\ub8cc \u2192 8/6 \uc608\uc0c1\uc218\uc815 \uacf5\uc2dc\uc758 \u300c(\u3054\u53c2\u8003)\u524d\u671f\u5b9f\u7e3e\u300d\uc5d0\uc11c \ucde8\ub4dd)\n- **\ucee8\uc13c\uc11c\uc2a4**: kabuyoho.jp 2026-08-21 \uae30\uc900 FY2027/3 \ud1b5\uae30 \uc21c\uc774\uc775 **134,514\ubc31\ub9cc\uc5d4** \u2192 \ud68c\uc0ac \uac00\uc774\ub358\uc2a4 123,500 \ub300\ube44 **-8.2%(\uacc4\uc0b0)**. \ub2f9\uc2dc \ub9e4\ucd9c \ucee8\uc13c 1,725,157\uc740 5/7 \uad6c \uac00\uc774\ub358\uc2a4 1,723,000\uc5d0 \uac00\uae5d\uace0 8/6 \uc0c1\ud5a5\uce58 1,732,000\ubcf4\ub2e4 \ub0ae\uc544 \uac31\uc2e0 \uc9c0\uc5f0 \uac00\ub2a5\uc131\uc774 \uc788\ub2e4. \ubc18\uba74 \uc774\uc775\uc9c0\ud45c 197,643\uc740 \uc0ac\uc774\ud2b8 \ub77c\ubca8\uc774 **\u7d4c\u5e38\u5229\u76ca**\uc774\ub77c \ud68c\uc0ac\uc758 IFRS **\u4e8b\u696d\u5229\u76ca 202,000\uacfc \uc9c1\uc811 \ube44\uad50\ud558\uc9c0 \uc54a\ub294\ub2e4**. **Q1 \ub2e8\uc77c\ubd84\uae30 \ucee8\uc13c\uc740 \ubbf8\ud655\ubcf4**(kabutan/minkabu 403).\n- **priced-in (pct_est 65)**: \uacf5\uc2dc\uac00 8/6 \uc7a5 \ub9c8\uac10 \ud6c4\uc5ec\uc11c \ubc18\uc751 \uccab\ub0a0 8/7 \uc885\uac00 5,196\uc5d4\uc73c\ub85c **0.0% \ubb34\ubc18\uc751**, \uc774\ud6c4 8/13 5,636\uc5d4\uae4c\uc9c0 **+8.5%(\uacc4\uc0b0)** \uc9c0\uc5f0 \uc0c1\uc2b9 