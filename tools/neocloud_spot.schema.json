{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nebius normalized archive v2",
  "description": "Structural schema. Collector additionally enforces hashes, UTC hourly boundaries, platform-family mapping, uniqueness, Decimal canonicalization and immutable identity.",
  "oneOf": [
    {
      "$ref": "#/$defs/index"
    },
    {
      "$ref": "#/$defs/shard"
    }
  ],
  "$defs": {
    "current": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sku_id": {
          "type": "string",
          "minLength": 1
        },
        "product_title": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "enum": [
            "gpu-b300-sxm",
            "gpu-b200-sxm",
            "gpu-b200-sxm-a",
            "gpu-h200-sxm",
            "gpu-h100-sxm",
            "gpu-rtx6000",
            "gpu-rtx6000-a"
          ]
        },
        "family": {
          "enum": [
            "B300",
            "B200",
            "H200",
            "H100",
            "RTX PRO 6000"
          ]
        },
        "currency": {
          "const": "USD"
        },
        "unit": {
          "const": "USD/GPU-hour"
        },
        "price": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,10})(\\.[0-9]{1,30})?$"
        },
        "source_snapshot_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "collected_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "source_endpoint": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "effective_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "sku_id",
        "product_title",
        "region",
        "platform",
        "family",
        "currency",
        "unit",
        "price",
        "source_snapshot_time",
        "collected_time",
        "source_endpoint",
        "source_sha256",
        "effective_time"
      ]
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sku_id": {
          "type": "string",
          "minLength": 1
        },
        "product_title": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "enum": [
            "gpu-b300-sxm",
            "gpu-b200-sxm",
            "gpu-b200-sxm-a",
            "gpu-h200-sxm",
            "gpu-h100-sxm",
            "gpu-rtx6000",
            "gpu-rtx6000-a"
          ]
        },
        "family": {
          "enum": [
            "B300",
            "B200",
            "H200",
            "H100",
            "RTX PRO 6000"
          ]
        },
        "currency": {
          "const": "USD"
        },
        "unit": {
          "const": "USD/GPU-hour"
        },
        "price": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,10})(\\.[0-9]{1,30})?$"
        },
        "source_snapshot_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "collected_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "source_endpoint": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "interval_start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "interval_end": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "method": {
          "enum": [
            "METHOD_LAST_PRICE",
            "METHOD_AVG_PRICE"
          ]
        },
        "granularity": {
          "const": "GRANULARITY_HOUR_1"
        }
      },
      "required": [
        "sku_id",
        "product_title",
        "region",
        "platform",
        "family",
        "currency",
        "unit",
        "price",
        "source_snapshot_time",
        "collected_time",
        "source_endpoint",
        "source_sha256",
        "interval_start",
        "interval_end",
        "method",
        "granularity"
      ]
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2
        },
        "source_urls": {
          "const": [
            "https://nebius.com/spot-prices",
            "https://docs.nebius.com/signup-billing/spot-prices",
            "https://api.nebius.cloud/billing/v1alpha1/spot-price",
            "https://api.nebius.cloud/billing/v1alpha1/spot-price/list-series"
          ]
        },
        "supported_families": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "enum": [
              "B300",
              "B200",
              "H200",
              "H100",
              "RTX PRO 6000"
            ]
          }
        },
        "current": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/current"
          }
        },
        "snapshot_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "collected_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "method": {
          "const": "METHOD_LAST_PRICE"
        },
        "granularity": {
          "const": "GRANULARITY_HOUR_1"
        },
        "shards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/shard_entry"
          }
        },
        "latest_complete_timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "imported_average_latest_timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "source_urls",
        "supported_families",
        "current",
        "snapshot_time",
        "collected_time",
        "method",
        "granularity",
        "shards",
        "latest_complete_timestamp",
        "imported_average_latest_timestamp"
      ]
    },
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/history"
          }
        }
      },
      "required": [
        "schema_version",
        "observations"
      ]
    },
    "shard_entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(history|imported-average)/[0-9]{4}-[0-9]{2}(-[0-9]{2,})?\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "method": {
          "enum": [
            "METHOD_LAST_PRICE",
            "METHOD_AVG_PRICE"
          ]
        },
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "path",
        "sha256",
        "count",
        "method",
        "start",
        "end"
      ]
    }
  }
}
